+        item(key = 0) {
+            FranchiseChip(index = 0, name = "All", isSelected = selected == 0, onTap = { onSelect(0) })
+        }
+        lazyRowItems(FRANCHISES, key = { it.index }) { f ->
+            FranchiseChip(index = f.index, name = f.name, isSelected = selected == f.index, onTap = { onSelect(if (selected == f.index) 0 else f.index) })
+        }
+    }
+}
