+
+// slot index -> pad number used by the emulated Toy Pad (1 = center, 2 = left, 3 = right)
+private val SLOT_PADS = intArrayOf(2, 1, 3, 2, 2, 3, 3)
+
+// slots of each side pad, from top to bottom (the middle one sits closer to the center pad)
+private val LEFT_SLOTS = intArrayOf(0, 4, 3)
+private val RIGHT_SLOTS = intArrayOf(2, 5, 6)
+private const val CENTER_SLOT = 1
+
+// order spots are filled when several figures are placed at once: both side pads first, the center pad last
+private val FILL_ORDER = intArrayOf(0, 4, 3, 2, 5, 6, CENTER_SLOT)
+
+// special views in the franchise strip (0 = everything, 1+ = a franchise)
+private const val FAVORITES_VIEW = -1
+private const val TEAM_VIEW = -2
+private const val RECENT_VIEW = -3
+
+private val TextOnBackground = Color(0xFFF2F5FF)
+private val TextDim = Color(0xFFB8C3E6)
+private val Bronze = Color(0xFFD9893A)
+private val Amber = Color(0xFFFFC107)
+private val TeamColor = Color(0xFF7FB2FF)
+private val OnPadColor = Color(0xFF43E0B0)
+
+private data class SlotInfo(val name: String, val number: Int)
+
+private data class PadLightState(val rgb: Int, val mode: Int, val param1: Int, val param2: Int)
+
+/** One figure in the collection: everything in the catalog, plus any figure file that isn't in it. */
+private data class FigureEntry(
+    val id: Int,
+    val name: String,
+    val franchise: Int,
+    val isVehicle: Boolean,
+    val family: String,
+    val build: Int,
+    val otherPath: String? = null, // only for figure files that aren't in the catalog
+)
+
+private val CATALOG_ENTRIES: List<FigureEntry> =
+    CATALOG.map { FigureEntry(it.id, it.name, it.franchise, it.isVehicle, it.family, it.build) }
+
+/**
+ * An empty vehicle tag. When the game asks you to build a new vehicle and "place the model on the central panel",
+ * it writes that vehicle onto a blank tag, which then works as that vehicle from then on.
+ */
+private val BLANK_TAG = FigureEntry(0, "Blank tag", 0, true, "", 0)
+
+private val ENTRY_BY_ID: Map<Int, FigureEntry> = CATALOG_ENTRIES.associateBy { it.id }
+
+private fun readSlots(): List<SlotInfo?> =
+    List(NativeEmulatedUSBDevices.MAX_DIMENSIONS_SLOTS) { index ->
+        val name = NativeEmulatedUSBDevices.getDimensionsFigureSlot(index) ?: return@List null
+        val number = try {
+            NativeEmulatedUSBDevices.getDimensionsFigureSlotNumber(index)
+        } catch (_: Throwable) {
+            -1
+        }
+        SlotInfo(CATALOG_BY_ID[number]?.name ?: name, number)
+    }
+
+private fun readLights(): List<PadLightState> {
+    val raw = try {
+        NativeEmulatedUSBDevices.getDimensionsPadLights()
+    } catch (_: Throwable) {
+        IntArray(12)
+    }
+    return List(3) { i ->
+        PadLightState(
+            rgb = raw.getOrElse(i * 4) { 0 },
+            mode = raw.getOrElse(i * 4 + 1) { 0 },
+            param1 = raw.getOrElse(i * 4 + 2) { 0 } and 0xFF,
+            param2 = (raw.getOrElse(i * 4 + 2) { 0 } shr 8) and 0xFF,
+        )
+    }
+}
+
+/** Figure files on the device: figure number -> file (first one by name), plus files that aren't in the catalog. */
+private data class InstalledFigures(val pathById: Map<Int, String>, val others: List<FigureEntry>)
+
+private fun readInstalledFigures(): InstalledFigures {
+    val files = try {
+        NativeEmulatedUSBDevices.getInstalledDimensionsMiniFigures().sortedBy { it.name.lowercase() }
+    } catch (_: Throwable) {
+        emptyList()
+    }
+    val pathById = HashMap<Int, String>()
+    val others = ArrayList<FigureEntry>()
+    for (file in files) {
+        val id = FigureNumbers.forPath(file.path)
+        if (id == 0 || CATALOG_BY_ID.containsKey(id)) { // 0 = a blank tag the game hasn't written to yet
+            pathById.putIfAbsent(id, file.path)
+        } else {
+            others.add(FigureEntry(id, file.name, 0, id >= 1000, "", 0, otherPath = file.path))
+        }
+    }
+    return InstalledFigures(pathById, others)
+}
+
+/** Letters and digits only, lower case, so "Ka-Pow" matches "kapow". */
+private fun searchKey(text: String) = text.lowercase().filter { it.isLetterOrDigit() }
+
+// light index for a pad number: 1 = center -> 0, 2 = left -> 1, 3 = right -> 2
+private fun lightIndexForPad(pad: Int) = (pad - 1).coerceIn(0, 2)
+
+@Composable
+fun ToyPadScreen() {
+    var slots by remember { mutableStateOf(readSlots()) }
+    var lights by remember { mutableStateOf(readLights()) }
+    var installed by remember { mutableStateOf(readInstalledFigures()) }
+    var selectedSlot by remember { mutableStateOf<Int?>(null) }
+    var selectedFigure by remember { mutableStateOf<FigureEntry?>(null) }
+    var moveSource by remember { mutableStateOf<Int?>(null) }
+    var errorMessage by remember { mutableStateOf<String?>(null) }
+    var franchise by remember { mutableIntStateOf(0) } // 0 = all
+    var query by remember { mutableStateOf("") }
+    var typing by remember { mutableStateOf(false) }
+    var infoFigure by remember { mutableStateOf<FigureEntry?>(null) } // figure whose info card is open (long press)
+    var abilityFilter by remember { mutableStateOf<String?>(null) }
+    var pickingAbility by remember { mutableStateOf(false) }
+    val context = LocalContext.current
+    var favorites by remember { mutableStateOf(ToyPadLists.favorites(context)) }
+    var team by remember { mutableStateOf(ToyPadLists.team(context)) }
+    var recent by remember { mutableStateOf(ToyPadLists.recent(context)) }
+    var lastQuickSlot by remember { mutableStateOf<Int?>(null) } // spot filled by the last "put one on the pad"
+    var lastQuickNumber by remember { mutableIntStateOf(-1) }
+
+    LaunchedEffect(Unit) {
+        var tick = 0
+        while (true) {
+            slots = readSlots()
+            lights = readLights()
+            if (tick % 16 == 0) {
+                installed = readInstalledFigures()
+            }
+            tick++
+            delay(250)
+        }
+    }
+
+    fun refresh() {
+        slots = readSlots()
+    }
+
+    fun clearSelection() {
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    /** Path of the figure file for this entry, making the figure the first time it's used. */
+    fun pathFor(entry: FigureEntry): String? {
+        entry.otherPath?.let { return it }
+        installed.pathById[entry.id]?.let { return it }
+        val created = try {
+            NativeEmulatedUSBDevices.createDimensionsFigure(entry.id.toLong())
+        } catch (_: Throwable) {
+            false
+        }
+        if (!created) return null
+        installed = readInstalledFigures()
+        return installed.pathById[entry.id]
+    }
+
+    fun loadFigure(entry: FigureEntry, index: Int) {
+        // a figure can only be in one place: if it's already on the pad, move it instead (also an unused blank tag)
+        val current = if (entry.id >= 0) slots.indexOfFirst { it?.number == entry.id } else -1
+        if (current >= 0) {
+            if (current != index) {
+                NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(current)
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[current], current)
+            }
+            errorMessage = null
+        } else {
+            val path = pathFor(entry)
+            val ok = path != null && NativeEmulatedUSBDevices.loadDimensionsFigure(path, SLOT_PADS[index], index)
+            errorMessage = if (ok) null else "Couldn't place ${entry.name}"
+            if (ok && ENTRY_BY_ID.containsKey(entry.id)) recent = ToyPadLists.addRecent(context, entry.id)
+        }
+        clearSelection()
+        refresh()
+    }
+
+    fun cancelMove() {
+        moveSource?.let { NativeEmulatedUSBDevices.cancelRemoveDimensionsFigure(it) }
+        moveSource = null
+        clearSelection()
+        refresh()
+    }
+
+    fun onSlotTapped(index: Int) {
+        errorMessage = null
+        typing = false
+        val source = moveSource
+        if (source != null) {
+            if (source == index) {
+                cancelMove()
+            } else {
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[source], source)
+                moveSource = null
+                clearSelection()
+                refresh()
+            }
+            return
+        }
+        val figure = selectedFigure
+        if (figure != null) {
+            loadFigure(figure, index)
+            return
+        }
+        selectedSlot = if (selectedSlot == index) null else index
+    }
+
+    fun onFigureTapped(entry: FigureEntry) {
+        errorMessage = null
+        typing = false
+        if (moveSource != null) return
+        val slot = selectedSlot
+        if (slot != null) {
+            loadFigure(entry, slot)
+            return
+        }
+        selectedFigure = if (selectedFigure == entry) null else entry
+    }
+
+    fun onRemove(index: Int) {
+        NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[index], index)
+        clearSelection()
+        refresh()
+    }
+
+    fun showInfoForSlot(index: Int) {
+        val number = slots[index]?.number ?: return
+        infoFigure = if (number == 0) BLANK_TAG else ENTRY_BY_ID[number] ?: return
+    }
+
+    fun placeFromInfo(entry: FigureEntry) {
+        infoFigure = null
+        val slot = selectedSlot
+        if (slot != null) loadFigure(entry, slot) else selectedFigure = entry
+    }
+
+    fun showAbility(ability: String) {
+        // everyone with this ability, across all franchises
+        infoFigure = null
+        abilityFilter = ability
+        franchise = 0
+        query = ""
+        typing = false
+        pickingAbility = false
+    }
+
+    fun toggleFavorite(number: Int) {
+        favorites = if (number in favorites) favorites - number else favorites + number
+        ToyPadLists.setFavorites(context, favorites)
+    }
+
+    fun toggleTeam(number: Int) {
+        team = when {
+            number in team -> team - number
+            team.size < ToyPadLists.TEAM_SIZE -> team + number
+            else -> team
+        }
+        ToyPadLists.setTeam(context, team)
+    }
+
+    /** Takes everything off the pad and puts the saved team on it. */
+    fun placeTeam() {
+        if (moveSource != null) cancelMove()
+        val members = team.mapNotNull { ENTRY_BY_ID[it] }.take(ToyPadLists.TEAM_SIZE)
+        if (members.isEmpty()) return
+        slots.forEachIndexed { index, slot ->
+            if (slot != null) NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[index], index)
+        }
+        var failed = 0
+        members.forEachIndexed { n, entry ->
+            val slot = FILL_ORDER[n]
+            val path = pathFor(entry)
+            if (path == null || !NativeEmulatedUSBDevices.loadDimensionsFigure(path, SLOT_PADS[slot], slot)) failed++
+        }
+        lastQuickSlot = null
+        clearSelection()
+        refresh()
+        errorMessage = if (failed > 0) "Couldn't place $failed of your team" else null
+    }
+
+    /** Puts a figure with this ability on the pad: in a free spot, or in place of the last one put there this way. */
+    fun placeWithAbility(ability: String) {
+        if (moveSource != null) cancelMove()
+        val alreadyThere = slots.mapNotNull { it?.number }.firstOrNull { ability in abilitiesOf(it) }
+        if (alreadyThere != null) {
+            errorMessage = "${ENTRY_BY_ID[alreadyThere]?.name ?: "A figure"} on the pad already has $ability"
+            return
+        }
+        val candidates = CATALOG_ENTRIES.filter { ability in abilitiesOf(it.id) }
+        // characters first (vehicles only for abilities no character has); favorites, then the team, then figures used before
+        val pick = candidates.filter { !it.isVehicle }.ifEmpty { candidates }.minWithOrNull(
+            compareBy<FigureEntry>(
+                {
+                    when {
+                        it.id in favorites -> 0
+                        it.id in team -> 1
+                        installed.pathById.containsKey(it.id) -> 2
+                        else -> 3
+                    }
+                },
+                { it.name.lowercase() },
+            )
+        ) ?: return
+        val free = FILL_ORDER.firstOrNull { slots[it] == null }
+        val target = free ?: lastQuickSlot?.takeIf { slots[it]?.number == lastQuickNumber }
+        if (target == null) {
+            errorMessage = "The pad is full. Remove a figure to make room for one with $ability."
+            return
+        }
+        if (free == null) NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[target], target)
+        loadFigure(pick, target)
+        if (errorMessage == null) {
+            lastQuickSlot = target
+            lastQuickNumber = pick.id
+            errorMessage = "Put ${pick.name} on the pad ($ability)"
+        }
+    }
+
+    fun onMove(index: Int) {
+        NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(index)
+        moveSource = index
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    val onPadNumbers = slots.mapNotNull { it?.number }.filter { it > 0 }.toSet()
+    val allEntries = remember(installed) { CATALOG_ENTRIES + installed.others }
+    val key = searchKey(query)
+    val ability = abilityFilter
+    fun inView(e: FigureEntry): Boolean = when (franchise) {
+        0 -> true
+        FAVORITES_VIEW -> e.id in favorites
+        TEAM_VIEW -> e.id in team
+        RECENT_VIEW -> e.id in recent
+        else -> e.franchise == franchise
+    }
+    val shown = remember(allEntries, franchise, key, ability, favorites, team, recent) {
+        allEntries.filter { e ->
+            inView(e) &&
+                    (ability == null || ability in abilitiesOf(e.id)) &&
+                    (key.isEmpty() || searchKey(e.name).contains(key) ||
+                            searchKey(FRANCHISES.getOrNull(e.franchise - 1)?.name ?: "").contains(key) ||
+                            abilitiesOf(e.id).any { searchKey(it).contains(key) })
+        }
+    }
+    // abilities to pick from, with how many figures (in the chosen franchise) have each
+    val abilityCounts = remember(allEntries, franchise, favorites, team, recent) {
+        val inFranchise = allEntries.filter { inView(it) }
+        ALL_ABILITIES.map { a -> a to inFranchise.count { a in abilitiesOf(it.id) } }.filter { it.second > 0 }
+    }
+    val characters = remember(shown) { shown.filter { !it.isVehicle }.sortedBy { it.name.lowercase() } }
+    // the team and recent views keep their own order (team order, newest first)
+    val orderedIds: List<Int>? = when (franchise) {
+        TEAM_VIEW -> team
+        RECENT_VIEW -> recent
+        else -> null
+    }
+    val orderedShown = remember(shown, orderedIds) { orderedIds?.mapNotNull { number -> shown.firstOrNull { it.id == number } } ?: emptyList() }
+    val padAbilities = remember(onPadNumbers) { onPadNumbers.flatMap { abilitiesOf(it) }.toSet() }
+    val vehicles = remember(shown, franchise, key, ability) {
+        val list = shown.filter { it.isVehicle }
+        // inside a franchise keep each vehicle's three builds together; otherwise A to Z
+        val sorted = if (franchise > 0) list.sortedWith(compareBy({ it.family.lowercase() }, { it.build }, { it.name.lowercase() }))
+        else list.sortedBy { it.name.lowercase() }
+        // the blank tag comes first in every list, for when the game asks for a newly built vehicle
+        val showBlank = ability == null && franchise >= 0 && (key.isEmpty() || searchKey(BLANK_TAG.name).contains(key))
+        if (showBlank) listOf(BLANK_TAG) + sorted else sorted
+    }
+
+    Box(modifier = Modifier.fillMaxSize()) {
+        ToyPadBackground()
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = 12.dp, vertical = 10.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            // title, with the search box in the space to its right
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                if (!typing) {
+                    Text(
+                        text = "LEGO Dimensions Toy Pad",
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.SemiBold,
+                        color = TextOnBackground,
+                        maxLines = 1,
+                    )
+                }
+                SearchBox(
+                    query = query,
+                    typing = typing,
+                    onTap = {
+                        typing = true
+                        pickingAbility = false
+                    },
+                    onClear = { query = "" },
+                    modifier = Modifier.weight(1f),
+                )
+                AbilityButton(
+                    selected = abilityFilter,
+                    open = pickingAbility,
+                    onTap = {
+                        typing = false
+                        pickingAbility = !pickingAbility
+                    },
+                    onClear = { abilityFilter = null },
+                )
+            }
+
+            if (!typing) {
+                // the pad
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .weight(1f),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    SidePad(
+                        slotIndices = LEFT_SLOTS,
+                        innerOnRight = true,
+                        light = lights[lightIndexForPad(2)],
+                        slots = slots,
+                        selectedSlot = selectedSlot,
+                        moveSource = moveSource,
+                        onSlotTapped = ::onSlotTapped,
+                        onSlotLongPressed = ::showInfoForSlot,
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight(),
+                    )
+                    CenterPad(
+                        light = lights[lightIndexForPad(1)],
+                        slot = slots[CENTER_SLOT],
+                        isSelected = selectedSlot == CENTER_SLOT,
+                        isMoveSource = moveSource == CENTER_SLOT,
+                        onTap = { onSlotTapped(CENTER_SLOT) },
+                        onLongPress = { showInfoForSlot(CENTER_SLOT) },
+                        modifier = Modifier
+                            .weight(0.95f)
+                            .fillMaxHeight(),
+                    )
+                    SidePad(
+                        slotIndices = RIGHT_SLOTS,
+                        innerOnRight = false,
+                        light = lights[lightIndexForPad(3)],
+                        slots = slots,
+                        selectedSlot = selectedSlot,
+                        moveSource = moveSource,
+                        onSlotTapped = ::onSlotTapped,
+                        onSlotLongPressed = ::showInfoForSlot,
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight(),
+                    )
+                }
+
+                // what to do next (only shown while something is selected or being moved)
+                if (errorMessage != null || moveSource != null || selectedFigure != null || selectedSlot != null) ActionBar(
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    selectedFigure = selectedFigure,
+                    moveSource = moveSource,
+                    errorMessage = errorMessage,
+                    onMove = ::onMove,
+                    onRemove = ::onRemove,
+                    onCancel = {
+                        if (moveSource != null) cancelMove() else clearSelection()
+                    },
+                )
+            }
+
+            if (typing) {
+                OnScreenKeyboard(
+                    onKey = { query += it },
+                    onBackspace = { if (query.isNotEmpty()) query = query.dropLast(1) },
+                    onDone = { typing = false },
+                )
+            } else {
+                FranchiseStrip(
+                    selected = franchise,
+                    favoriteCount = favorites.size,
+                    teamCount = team.size,
+                    onSelect = { franchise = it },
+                )
+            }
+
+            // figure collection (or the list of abilities to pick from)
+            if (pickingAbility) AbilityPicker(
+                abilities = abilityCounts,
+                selected = abilityFilter,
+                onPad = padAbilities,
+                onPick = { picked ->
+                    abilityFilter = if (abilityFilter == picked) null else picked
+                    pickingAbility = false
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.15f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+            ) else LazyVerticalGrid(
+                columns = GridCells.Adaptive(minSize = 84.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.15f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+                contentPadding = PaddingValues(8.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                if (ability != null && orderedIds == null) {
+                    item(span = { GridItemSpan(maxLineSpan) }) {
+                        AbilityQuickPlace(
+                            ability = ability,
+                            onPadName = slots.firstOrNull { slot -> slot != null && ability in abilitiesOf(slot.number) }?.name,
+                            onPlace = { placeWithAbility(ability) },
+                        )
+                    }
+                }
+                if (orderedIds != null) {
+                    item(span = { GridItemSpan(maxLineSpan) }) {
+                        if (franchise == TEAM_VIEW) TeamHeader(count = team.size, onPlace = ::placeTeam)
+                        else SectionLabel("Recently placed (${orderedShown.size})")
+                    }
+                    if (orderedIds.isEmpty()) {
+                        item(span = { GridItemSpan(maxLineSpan) }) {
+                            SectionLabel(
+                                if (franchise == TEAM_VIEW) "Hold a figure and tap Team to add it (up to ${ToyPadLists.TEAM_SIZE})."
+                                else "Figures you put on the pad show up here, newest first."
+                            )
+                        }
+                    }
+                    items(orderedShown, key = { "o${it.id}" }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.id in onPadNumbers,
+                            isFavorite = entry.id in favorites,
+                            inTeam = entry.id in team,
+                            onTap = { onFigureTapped(entry) },
+                            onLongPress = { infoFigure = entry },
+                        )
+                    }
+                } else if (characters.isEmpty() && vehicles.isEmpty()) {
+                    val emptyText = when {
+                        key.isNotEmpty() -> "Nothing matches \"$query\""
+                        ability != null -> "No figures here with $ability"
+                        franchise == FAVORITES_VIEW -> "Hold a figure and tap the star to make it a favorite."
+                        else -> "Nothing here"
+                    }
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel(emptyText) }
+                }
+                if (orderedIds == null && characters.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Characters (${characters.size})") }
+                    items(characters, key = { "c${it.id}${it.otherPath ?: ""}" }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.id in onPadNumbers,
+                            isFavorite = entry.id in favorites,
+                            inTeam = entry.id in team,
+                            onTap = { onFigureTapped(entry) },
+                            onLongPress = { infoFigure = entry },
+                        )
+                    }
+                }
+                if (orderedIds == null && vehicles.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Vehicles and gadgets (${vehicles.count { it.id != BLANK_TAG.id }})") }
+                    items(vehicles, key = { "v${it.id}${it.otherPath ?: ""}" }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.id in onPadNumbers,
+                            isFavorite = entry.id in favorites,
+                            inTeam = entry.id in team,
+                            onTap = { onFigureTapped(entry) },
+                            onLongPress = { infoFigure = entry },
+                        )
+                    }
+                }
+            }
+        }
+
+        // info card for a figure (long press on it in the list or on the pad)
+        infoFigure?.let { entry ->
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(Color(0xB3000000))
+                    .clickable(interactionSource = remember { MutableInteractionSource() }, indication = null) { infoFigure = null },
+                contentAlignment = Alignment.Center,
+            ) {
+                FigureInfoCard(
+                    entry = entry,
+                    isOnPad = entry.id in onPadNumbers,
+                    isFavorite = entry.id in favorites,
+                    inTeam = entry.id in team,
+                    teamFull = team.size >= ToyPadLists.TEAM_SIZE,
+                    onToggleFavorite = { toggleFavorite(entry.id) },
+                    onToggleTeam = { toggleTeam(entry.id) },
+                    onAbility = ::showAbility,
+                    onShowFigure = { infoFigure = it },
+                    onPlace = { placeFromInfo(entry) },
+                    onClose = { infoFigure = null },
+                )
+            }
+        }
+    }
+}
