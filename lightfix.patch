+	// Cemu LD+: keeps the calling host thread on a group of host CPUs (no effect without a fast/slow split)
+	void __CemuSetHostThreadCpus(HostCpuGroup group, const char* what)
+	{
+#if defined(__linux__)
+		const HostCpuTiers& tiers = _GetHostCpuTiers();
+		if (tiers.fast == 0 || tiers.slow == 0)
+			return;
+		// the fastest CPUs are only kept apart when there are at least two other fast ones
+		const uint64 otherFast = tiers.fast & ~tiers.fastest;
+		const bool splitFastest = tiers.fastest != 0 && std::popcount(otherFast) >= 2;
+		uint64 mask = tiers.fast;
+		switch (group)
+		{
+		case HostCpuGroup::Fastest:
+			mask = splitFastest ? tiers.fastest : tiers.fast;
+			break;
+		case HostCpuGroup::OtherFast:
+			mask = splitFastest ? otherFast : tiers.fast;
+			break;
+		case HostCpuGroup::Fast:
+			mask = tiers.fast;
+			break;
+		case HostCpuGroup::Slow:
+			mask = tiers.slow;
+			break;
+		}
+		if (syscall(SYS_sched_setaffinity, 0, sizeof(mask), &mask) != 0)
+		{
+			cemuLog_log(LogType::Force, "[CPU] could not set host CPUs for {} (error {})", what, errno);
+			return;
+		}
+		std::string list;
+		for (uint32 cpu = 0; cpu < 64; cpu++)
+			if ((mask >> cpu) & 1)
+				list.append(fmt::format("{}{}", list.empty() ? "" : ",", cpu));
+		cemuLog_log(LogType::Force, "[CPU] {} kept on host CPUs {}", what, list);
+#endif
+	}
