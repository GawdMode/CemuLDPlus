--- /dev/null
+++ b/src/android/app/src/main/java/info/cemu/cemu/nativeinterface/NativeAudioBoost.kt
@@ -0,0 +1,29 @@
+package info.cemu.cemu.nativeinterface
+
+import android.content.Context
+
+/** Extra loudness for the game's TV sound (Cemu LD+). Stored in the app's preferences. */
+object NativeAudioBoost {
+    private const val PREFS = "lightfix_audio"
+    private const val KEY_BOOST_DB = "volume_boost_db"
+    const val MAX_BOOST_DB = 18
+    const val STEP_DB = 3
+
+    @JvmStatic
+    external fun setVolumeBoost(db: Int)
+
+    fun getSavedBoostDb(context: Context): Int =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getInt(KEY_BOOST_DB, 0).coerceIn(0, MAX_BOOST_DB)
+
+    fun saveBoostDb(context: Context, db: Int) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putInt(KEY_BOOST_DB, db.coerceIn(0, MAX_BOOST_DB)).apply()
+    }
+
+    /** Send the saved value to the emulator. */
+    fun apply(context: Context) {
+        try {
+            setVolumeBoost(getSavedBoostDb(context))
+        } catch (_: Throwable) {
+        }
+    }
+}
