+		cemuLog_log(LogType::Force, "[Audio] last {:.0f} s: mixed {} frames ({} expected) | ran dry {} times ({} ms of silence) | dropped {} blocks | lowest buffer {} | calls from other cores during mixing {} | limiter {:.1f} dB",
+			seconds, ax.framesMixed, (uint64)(seconds * 1000.0 / 3.0), out.underruns, out.silenceUs / 1000, out.droppedBlocks, lowest, ax.callsDuringMix, limiterDb);
+		// emulated CPU: how much of the time each core had work to do
+		uint64 idleUs[3];
+		coreinit::__OSTakeCoreIdleStats(idleUs);
+		auto busyPercent = [&](uint64 idle) {
+			const double idleShare = std::clamp((double)idle / (double)windowUs, 0.0, 1.0);
+			return (uint32)std::lround((1.0 - idleShare) * 100.0);
+		};
+		// which host CPUs each emulated core ran on (biggest shares first)
+		uint32 hostSamples[3][coreinit::kHostCpuSampleSlots];
+		coreinit::__OSTakeHostCpuStats(hostSamples);
+		auto hostCpus = [&](sint32 core) {
+			uint64 total = 0;
+			for (uint32 i = 0; i < coreinit::kHostCpuSampleSlots; i++)
+				total += hostSamples[core][i];
+			if (total == 0)
+				return std::string();
+			std::vector<std::pair<uint32, uint32>> shares;
+			for (uint32 i = 0; i < coreinit::kHostCpuSampleSlots; i++)
+			{
+				const uint32 pct = (uint32)(hostSamples[core][i] * 100 / total);
+				if (pct >= 5)
+					shares.emplace_back(pct, i);
+			}
+			std::sort(shares.begin(), shares.end(), [](auto& a, auto& b) { return a.first > b.first; });
+			std::string text = " on host CPU";
+			for (size_t i = 0; i < shares.size() && i < 3; i++)
+				text.append(fmt::format("{} {} ({}%)", i == 0 ? "" : ",", shares[i].second, shares[i].first));
+			return text;
+		};
+		if (coreinit::__CemuIsMulticoreMode())
+			cemuLog_log(LogType::Force, "[CPU] last {:.0f} s: core 0 busy {}%{} | core 1 busy {}%{} | core 2 busy {}%{}", seconds,
+				busyPercent(idleUs[0]), hostCpus(0), busyPercent(idleUs[1]), hostCpus(1), busyPercent(idleUs[2]), hostCpus(2));
+		else
+			cemuLog_log(LogType::Force, "[CPU] last {:.0f} s: emulated CPU busy {}%{} (single-core mode)", seconds, busyPercent(idleUs[0]), hostCpus(0));
+		// the game's threads, twice: once things have started up and once in gameplay
+		s_hitchSummaryIndex++;
+		if (s_hitchSummaryIndex == 3 || s_hitchSummaryIndex == 12)
+			coreinit::__OSLogThreadList(snd_core::AXIst_GetThread());
+	}
+
+	const char* const s_hitchNames[kHitchCategories] = {
+		"waiting for game", "new shaders", "shader compile", "pipelines", "textures",
+		"readback", "fences", "GPU busy", "present", "disc reads", "background pipelines", "pipelines made again"};
+	// categories where the number of events is worth showing
+	const bool s_hitchShowCount[kHitchCategories] = {false, true, true, true, true, true, false, false, false, false, true, true};
+
+	std::string _LatteHitch_Describe(const uint64* us, const uint32* count, uint64 bytesRead, uint32 newTextures, uint64 minUs)
+	{
+		std::string text;
+		for (uint32 i = 0; i < kHitchCategories; i++)
+		{
+			const bool counted = s_hitchShowCount[i] && count[i] > 0;
+			if (us[i] < minUs && !counted)
+				continue;
+			text.append(fmt::format(" | {}", s_hitchNames[i]));
+			if (counted)
+				text.append(fmt::format(" x{}", count[i]));
+			text.append(fmt::format(" {} ms", us[i] / 1000));
+			if (i == (uint32)LatteHitch::DiscRead && bytesRead > 0)
+				text.append(fmt::format(" ({:.1f} MB)", (double)bytesRead / (1024.0 * 1024.0)));
+		}
+		if (newTextures > 0)
+			text.append(fmt::format(" | new textures {}", newTextures));
+		return text;
+	}
+}
+
+uint64 LatteHitch_NowUs()
+{
+	return (uint64)std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void LatteHitch_Add(LatteHitch category, uint64 microseconds)
+{
+	const uint32 i = (uint32)category;
+	if (i >= kHitchCategories)
+		return;
+	s_hitchFrame.us[i].fetch_add(microseconds, std::memory_order_relaxed);
+	s_hitchFrame.count[i].fetch_add(1, std::memory_order_relaxed);
+}
+
+void LatteHitch_AddBytesRead(uint64 bytes)
+{
+	s_hitchFrame.bytesRead.fetch_add(bytes, std::memory_order_relaxed);
+}
+
+void LatteHitch_CountNewTexture()
+{
+	s_hitchFrame.newTextures.fetch_add(1, std::memory_order_relaxed);
+}
+
+void LatteHitch_FrameEnd()
+{
+	const uint64 now = LatteHitch_NowUs();
+	uint64 us[kHitchCategories];
+	uint32 count[kHitchCategories];
+	for (uint32 i = 0; i < kHitchCategories; i++)
+	{
+		us[i] = s_hitchFrame.us[i].exchange(0, std::memory_order_relaxed);
+		count[i] = s_hitchFrame.count[i].exchange(0, std::memory_order_relaxed);
+	}
+	const uint64 bytesRead = s_hitchFrame.bytesRead.exchange(0, std::memory_order_relaxed);
+	const uint32 newTextures = s_hitchFrame.newTextures.exchange(0, std::memory_order_relaxed);
+	if (s_hitchLastFrameEnd == 0)
+	{
+		s_hitchLastFrameEnd = now;
+		s_hitchWindow.start = now;
+		return;
+	}
+	const uint64 frameUs = now - s_hitchLastFrameEnd;
+	s_hitchLastFrameEnd = now;
+
+	// a hitch is a frame that took much longer than usual (and long enough to notice)
+	const bool isHitch = s_hitchAvgFrameUs > 0.0 && frameUs > 34000 && (double)frameUs > s_hitchAvgFrameUs * 2.0;
+	if (frameUs < 1000000) // ignore pauses and loading screens for the average
+		s_hitchAvgFrameUs = s_hitchAvgFrameUs == 0.0 ? (double)frameUs : s_hitchAvgFrameUs * 0.95 + (double)frameUs * 0.05;
+
+	if (isHitch && s_hitchLogBudget > 0)
+	{
+		s_hitchLogBudget--;
+		cemuLog_log(LogType::Force, "[Hitch] {} ms frame (usual {} ms){}", frameUs / 1000, (uint64)(s_hitchAvgFrameUs / 1000.0),
+			_LatteHitch_Describe(us, count, bytesRead, newTextures, 1000));
+	}
+
+	s_hitchWindow.frames++;
+	if (isHitch)
+		s_hitchWindow.hitches++;
+	if (frameUs > 50000)
+		s_hitchWindow.framesOver50ms++;
+	s_hitchWindow.longestFrameUs = std::max(s_hitchWindow.longestFrameUs, frameUs);
+	for (uint32 i = 0; i < kHitchCategories; i++)
+	{
+		s_hitchWindow.us[i] += us[i];
+		s_hitchWindow.count[i] += count[i];
+	}
+	s_hitchWindow.bytesRead += bytesRead;
+	s_hitchWindow.newTextures += newTextures;
+
+	const uint64 windowUs = now - s_hitchWindow.start;
+	if (windowUs >= 10000000)
+	{
+		if (s_hitchSummaryBudget > 0)
+		{
+			s_hitchSummaryBudget--;
+			// time the graphics thread spent doing its own work (everything except waiting for the game, the display or the GPU)
+			const uint64 waitedUs = s_hitchWindow.us[(uint32)LatteHitch::WaitForGame] + s_hitchWindow.us[(uint32)LatteHitch::Present] +
+				s_hitchWindow.us[(uint32)LatteHitch::Fence] + s_hitchWindow.us[(uint32)LatteHitch::GpuWait];
+			const uint64 workUs = windowUs > waitedUs ? windowUs - waitedUs : 0;
+			cemuLog_log(LogType::Force, "[Perf] last {:.0f} s: {:.1f} fps, {} hitches, {} frames over 50 ms, longest {} ms | graphics work {} ms{}",
+				(double)windowUs / 1000000.0, (double)s_hitchWindow.frames * 1000000.0 / (double)windowUs, s_hitchWindow.hitches,
+				s_hitchWindow.framesOver50ms, s_hitchWindow.longestFrameUs / 1000, workUs / 1000,
+				_LatteHitch_Describe(s_hitchWindow.us, s_hitchWindow.count, s_hitchWindow.bytesRead, s_hitchWindow.newTextures, 1000));
+			_LatteHitch_LogSystemStats(windowUs);
+		}
+		s_hitchWindow = {};
+		s_hitchWindow.start = now;
+	}
+}
