+package info.cemu.cemu.emulation.toypadscreen
+
+import android.content.Context
+
+/** Favorite figures and the saved team (figures put on the pad together with one tap), by figure number. */
+object ToyPadLists {
+    private const val PREFS = "toypad_screen"
+    private const val KEY_FAVORITES = "favorites"
+    private const val KEY_TEAM = "team"
+    private const val KEY_RECENT = "recent"
+
+    /** The pad has 7 spots. */
+    const val TEAM_SIZE = 7
+
+    /** How many recently placed figures are remembered. */
+    const val RECENT_SIZE = 20
+
+    private fun read(context: Context, key: String): List<Int> =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getString(key, "")
+            .orEmpty()
+            .split(',')
+            .mapNotNull { it.trim().toIntOrNull() }
+            .filter { it > 0 }
+            .distinct()
+
+    private fun write(context: Context, key: String, numbers: List<Int>) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+            .putString(key, numbers.joinToString(","))
+            .apply()
+    }
+
+    fun favorites(context: Context): Set<Int> = read(context, KEY_FAVORITES).toSet()
+
+    fun setFavorites(context: Context, numbers: Set<Int>) = write(context, KEY_FAVORITES, numbers.sorted())
+
+    /** In the order the figures were added, which is also the order they go on the pad. */
+    fun team(context: Context): List<Int> = read(context, KEY_TEAM).take(TEAM_SIZE)
+
+    fun setTeam(context: Context, numbers: List<Int>) = write(context, KEY_TEAM, numbers.distinct().take(TEAM_SIZE))
+
+    /** Figures placed on the pad, newest first. */
+    fun recent(context: Context): List<Int> = read(context, KEY_RECENT).take(RECENT_SIZE)
+
+    /** Moves this figure to the front of the recent list and returns the new list. */
+    fun addRecent(context: Context, number: Int): List<Int> {
+        if (number <= 0) return recent(context)
+        val list = (listOf(number) + recent(context).filter { it != number }).take(RECENT_SIZE)
+        write(context, KEY_RECENT, list)
+        return list
+    }
+}
