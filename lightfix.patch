+@Composable
+private fun Portrait(
+    number: Int,
+    name: String?,
+    ringColor: Color,
+    ringWidth: Dp,
+    modifier: Modifier = Modifier,
+    emptyLabel: String? = null,
+) {
+    val image = if (number > 0) rememberFigureImage(number) else null
+    // characters stand on their Toy Tag; the tag's own outline replaces the plain ring unless the spot is highlighted
+    val tag = if (name != null && number in 1..999) rememberToyTagImage(number) else null
+    val showRing = tag == null || ringColor != Bronze
+    Box(
+        modifier = modifier
+            .clip(CircleShape)
+            .background(Brush.radialGradient(listOf(Color(0xFF2A4785), Color(0xFF0B1430))))
+            .then(if (showRing) Modifier.border(ringWidth, ringColor, CircleShape) else Modifier),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (tag != null) {
+            Image(
+                bitmap = tag,
+                contentDescription = null,
+                contentScale = ContentScale.FillBounds,
+                modifier = Modifier.fillMaxSize(),
+            )
+        }
+        when {
+            name == null -> Text(
+                text = emptyLabel ?: "+",
+                color = Color(0xCCFFFFFF),
+                fontSize = 30.sp,
+                fontWeight = FontWeight.Light,
+            )
+
+            image != null -> Image(
+                bitmap = image,
+                contentDescription = name,
+                contentScale = ContentScale.Fit,
+                modifier = Modifier
+                    .fillMaxSize()
+                    .padding(ringWidth + 3.dp),
+            )
+
+            else -> Text(
+                text = name,
+                color = Color.White,
+                textAlign = TextAlign.Center,
+                fontSize = 12.sp,
+                fontWeight = FontWeight.Medium,
+                maxLines = 3,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.padding(6.dp),
