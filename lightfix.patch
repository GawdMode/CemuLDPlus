@@ -0,0 +1,153 @@
+package info.cemu.cemu.emulation.toypadscreen
+
+import android.app.Presentation
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.view.Display
+import android.view.KeyEvent
+import android.view.MotionEvent
+import android.view.WindowManager
+import androidx.activity.ComponentActivity
+import androidx.compose.ui.platform.ComposeView
+import androidx.lifecycle.setViewTreeLifecycleOwner
+import androidx.lifecycle.setViewTreeViewModelStoreOwner
+import androidx.savedstate.setViewTreeSavedStateRegistryOwner
+import info.cemu.cemu.common.ui.components.ActivityContent
+import info.cemu.cemu.common.ui.localization.TranslatableContent
+import info.cemu.cemu.nativeinterface.NativeLogging
+import info.cemu.cemu.nativeinterface.NativeSettings
+
+/**
+ * Shows the LEGO Dimensions Toy Pad on a second display (for example the bottom screen of a dual-screen handheld)
+ * while the game keeps running on the main display.
+ */
+class ToyPadSecondScreen(private val activity: ComponentActivity) : DisplayManager.DisplayListener {
+    private val displayManager = activity.getSystemService(DisplayManager::class.java)
+    private var presentation: ToyPadPresentation? = null
+    private var started = false
+    private var loggedDisplays = false
+
+    fun start() {
+        if (started) return
+        started = true
+        displayManager.registerDisplayListener(this, Handler(Looper.getMainLooper()))
+        showIfPossible()
+    }
+
+    fun stop() {
+        if (!started) return
+        started = false
+        displayManager.unregisterDisplayListener(this)
+        dismiss()
+    }
+
+    private fun log(message: String) {
+        try {
+            NativeLogging.log("[ToyPadScreen] $message")
+        } catch (_: Throwable) {
+        }
+    }
+
+    private fun ownDisplayId(): Int {
+        return try {
+            activity.display?.displayId ?: Display.DEFAULT_DISPLAY
+        } catch (_: Throwable) {
+            Display.DEFAULT_DISPLAY
+        }
+    }
+
+    private fun findTargetDisplay(): Display? {
+        val ownId = ownDisplayId()
+        val displays = displayManager.displays
+        if (!loggedDisplays) {
+            loggedDisplays = true
+            log("game is on display $ownId, found ${displays.size} display(s)")
+            for (d in displays) {
+                log("display id=${d.displayId} name='${d.name}' flags=0x${Integer.toHexString(d.flags)} state=${d.state} size=${d.mode.physicalWidth}x${d.mode.physicalHeight}")
+            }
+        }
+        return displays.firstOrNull { it.displayId != ownId }
+    }
+
+    private fun showIfPossible() {
+        if (!started || presentation != null) return
+        val enabled = try {
+            NativeSettings.isEmulateDimensionsToypadEnabled()
+        } catch (_: Throwable) {
+            false
+        }
+        if (!enabled) {
+            log("emulated Toy Pad is turned off, not using the second screen")
+            return
+        }
+        val display = findTargetDisplay() ?: return
+        try {
+            val p = ToyPadPresentation(activity, display)
+            p.show()
+            presentation = p
+            log("showing Toy Pad on display ${display.displayId}")
+        } catch (e: Throwable) {
+            log("could not show Toy Pad on display ${display.displayId}: ${e.javaClass.simpleName}: ${e.message}")
+            presentation = null
+        }
+    }
+
+    private fun dismiss() {
+        try {
+            presentation?.dismiss()
+        } catch (_: Throwable) {
+        }
+        presentation = null
+    }
+
+    override fun onDisplayAdded(displayId: Int) {
+        showIfPossible()
+    }
+
+    override fun onDisplayRemoved(displayId: Int) {
+        if (presentation?.display?.displayId == displayId) {
+            log("display $displayId was removed")
+            dismiss()
+        }
+    }
+
+    override fun onDisplayChanged(displayId: Int) {
+    }
+}
+
+private class ToyPadPresentation(
+    private val activity: ComponentActivity,
+    display: Display,
+) : Presentation(activity, display) {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        // never take controller/keyboard focus away from the game on the main screen; touch still works
+        window?.addFlags(
+            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
+        )
+        val composeView = ComposeView(context).apply {
+            setViewTreeLifecycleOwner(activity)
+            setViewTreeViewModelStoreOwner(activity)
+            setViewTreeSavedStateRegistryOwner(activity)
+            setContent {
+                TranslatableContent {
+                    ActivityContent {
+                        ToyPadScreen()
+                    }
+                }
+            }
+        }
+        setContentView(composeView)
+    }
+
+    // if this window ever does receive controller input, hand it to the game
+    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
+        return activity.dispatchKeyEvent(event)
+    }
+
+    override fun dispatchGenericMotionEvent(event: MotionEvent): Boolean {
+        return activity.dispatchGenericMotionEvent(event)
+    }
+}
