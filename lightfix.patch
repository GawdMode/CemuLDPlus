+		buf[(36 * 4) + 1] = uint8((first >> 8) & 0xFF);
+		buf[(38 * 4) + 1] = 1;
+		cemuLog_log(LogType::Force, "Dimensions: repaired vehicle tag data for {} ({})", first, FindFigure(first));
+		return true;
