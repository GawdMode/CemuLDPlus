+// ---------------------------------------------------------------------------------------------------------------------
+// Offset (sub-region) texture relations
+// Some games render into surfaces that start in the middle of a larger surface. For example TT Games' LEGO titles
+// appear to render shadow cascades into 960x960 surfaces that are placed inside a single taller shadow atlas.
+// Previously, textures were only synchronized if they share the same start address, so only the first region of such
+// an atlas ever received data. The code below detects sub-textures that map onto a row range of a larger texture and
+// copies data between the two (sub <-> its row range in the base) whenever one of them is used and the other has newer data.
+// ---------------------------------------------------------------------------------------------------------------------
+
+static sint32 s_offsetRelLogBudget = 0; // set above 0 to log offset relation decisions (diagnostics)
+
+// verification results are cached per texture-shape pair, since the same pairs are re-checked whenever textures get recreated
+static std::unordered_map<uint64, bool> s_offsetRelVerifyCache;
+
+static uint32 _LatteTexture_NormalizeSwizzle(uint32 swizzle)
+{
+	// swizzle is stored either as raw pointer bits (0x000-0x700) or already shifted (0-7) depending on where the texture was created
+	if (swizzle > 7)
+		swizzle >>= 8;
+	return swizzle & 7;
+}
+
+// returns the byte offset of texel (x,y) of slice 0 / mip 0 relative to the start of the surface
+static bool _LatteTexture_GetTexelByteOffset(Latte::E_HWTILEMODE tileMode, uint32 bpp, uint32 pitch, uint32 height, uint32 swizzle, uint32 x, uint32 y, uint32& offsetOut)
+{
+	// note: isDepth only changes the pixel order inside an 8x8 micro tile, which does not matter for row-offset matching
+	switch (tileMode)
+	{
+	case Latte::E_HWTILEMODE::TM_LINEAR_GENERAL:
+	case Latte::E_HWTILEMODE::TM_LINEAR_ALIGNED:
+		offsetOut = LatteAddrLib::ComputeSurfaceAddrFromCoordLinear(x, y, 0, 0, bpp, pitch, height, 1);
+		return true;
+	case Latte::E_HWTILEMODE::TM_1D_TILED_THIN1:
+		offsetOut = LatteAddrLib::ComputeSurfaceAddrFromCoordMicroTiled(x, y, 0, bpp, pitch, height, tileMode, false);
+		return true;
+	case Latte::E_HWTILEMODE::TM_2D_TILED_THIN1:
+	case Latte::E_HWTILEMODE::TM_2D_TILED_THIN2:
+	case Latte::E_HWTILEMODE::TM_2D_TILED_THIN4:
+	case Latte::E_HWTILEMODE::TM_2B_TILED_THIN1:
+	case Latte::E_HWTILEMODE::TM_2B_TILED_THIN2:
+	case Latte::E_HWTILEMODE::TM_2B_TILED_THIN4:
+		offsetOut = LatteAddrLib::ComputeSurfaceAddrFromCoordMacroTiled(x, y, 0, 0, bpp, pitch, height, 1, tileMode, false, swizzle & 1, (swizzle >> 1) & 3);
+		return true;
+	default:
+		return false; // thick and 3D tile modes are not handled
+	}
+}
+
+// check if every texel (x,y) of subTexture maps to texel (x, y+yOffset) of baseTexture, given the byte offset between both surfaces
+static bool _LatteTexture_VerifyOffsetMapping(LatteTexture* baseTexture, uint32 baseSwizzle, LatteTexture* subTexture, uint32 subSwizzle, uint32 byteOffset, sint32 yOffset)
+{
+	const uint32 bpp = baseTexture->GetBPP();
+	const uint32 pitch = (uint32)baseTexture->pitch;
+	const sint32 w = subTexture->width;
+	const sint32 h = subTexture->height;
+	// sample a limited grid of texels (plus the edges) so verification stays cheap for large textures
+	auto oddStep = [](sint32 size, sint32 minStep) -> sint32 { sint32 s = std::max(minStep, size / 48); return s | 1; };
+	const sint32 stepY = oddStep(h, 7);
+	const sint32 stepX = oddStep(w, 5);
+	auto checkTexel = [&](sint32 x, sint32 y) -> bool
+	{
+		uint32 offSub, offBase;
+		if (!_LatteTexture_GetTexelByteOffset(subTexture->tileMode, bpp, pitch, subTexture->height, subSwizzle, x, y, offSub))
+			return false;
+		if (!_LatteTexture_GetTexelByteOffset(baseTexture->tileMode, bpp, pitch, baseTexture->height, baseSwizzle, x, y + yOffset, offBase))
+			return false;
+		return (offSub + byteOffset) == offBase;
+	};
+	for (sint32 y = 0; y < h; y += stepY)
+	{
+		for (sint32 x = 0; x < w; x += stepX)
+		{
+			if (!checkTexel(x, y))
+				return false;
+		}
+		if (!checkTexel(w - 1, y))
+			return false;
+	}
+	for (sint32 x = 0; x < w; x += stepX)
+	{
+		if (!checkTexel(x, h - 1))
+			return false;
+	}
+	return true;
+}
+
+// called when sliceMipInfoA (of textureA) and sliceMipInfoB (of textureB) overlap but don't start at the same address
+static void LatteTexture_TryTrackOffsetRelation(LatteTextureSliceMipInfo* sliceMipInfoA, LatteTextureSliceMipInfo* sliceMipInfoB)
+{
+	// figure out which one is the containing (base) slice
+	LatteTextureSliceMipInfo* baseInfo;
+	LatteTextureSliceMipInfo* subInfo;
+	if (sliceMipInfoA->addrStart < sliceMipInfoB->addrStart && sliceMipInfoB->addrEnd <= sliceMipInfoA->addrEnd)
+	{
+		baseInfo = sliceMipInfoA;
+		subInfo = sliceMipInfoB;
+	}
+	else if (sliceMipInfoB->addrStart < sliceMipInfoA->addrStart && sliceMipInfoA->addrEnd <= sliceMipInfoB->addrEnd)
+	{
+		baseInfo = sliceMipInfoB;
+		subInfo = sliceMipInfoA;
+	}
+	else
+		return; // partial overlap, not handled
+	LatteTexture* baseTexture = baseInfo->texture;
+	LatteTexture* subTexture = subInfo->texture;
+	if (baseTexture == subTexture)
+		return;
+	// only handle sub textures which are a single plain 2D surface and base mip 0
+	if (subInfo->sliceIndex != 0 || subInfo->mipIndex != 0 || baseInfo->mipIndex != 0)
+		return;
+	if (subTexture->depth != 1 || subTexture->Is3DTexture() || baseTexture->Is3DTexture())
+		return;
+	// check if this relation is already known
+	for (auto& it : baseTexture->list_compatibleRelations)
+	{
+		if (it->baseTexture == baseTexture && it->subTexture == subTexture)
+			return;
+	}
+
+	const uint32 byteOffset = subInfo->addrStart - baseInfo->addrStart;
+	const uint32 bpp = baseTexture->GetBPP();
+	const uint32 baseSwizzle = _LatteTexture_NormalizeSwizzle(baseTexture->swizzle);
+	const uint32 subSwizzle = _LatteTexture_NormalizeSwizzle(subTexture->swizzle);
+
+	auto logResult = [&](const char* result, sint32 yOffset)
+	{
+		if (s_offsetRelLogBudget <= 0)
+			return;
+		// only log each combination of texture shapes and result once
+		static std::unordered_set<uint64> s_loggedCombinations;
+		uint64 key = (uint64)(uintptr_t)result;
+		key = key * 31 + (uint64)baseTexture->width; key = key * 31 + (uint64)baseTexture->height; key = key * 31 + (uint64)baseTexture->format; key = key * 31 + (baseTexture->isDepth ? 1 : 2);
+		key = key * 31 + (uint64)subTexture->width; key = key * 31 + (uint64)subTexture->height; key = key * 31 + (uint64)subTexture->format; key = key * 31 + (subTexture->isDepth ? 1 : 2);
+		key = key * 31 + (uint64)(uint32)yOffset;
+		if (s_loggedCombinations.contains(key))
+			return;
+		s_loggedCombinations.insert(key);
+		s_offsetRelLogBudget--;
+		cemuLog_log(LogType::Force, "[OffsetTexSync] {} | base {:08x} {}x{}x{} pitch {} fmt {:04x} tm {} swz {} depth {} slice {} | sub {:08x} {}x{} pitch {} fmt {:04x} tm {} swz {} depth {} | byteOffset {:x} yOffset {}",
+			result,
+			baseTexture->physAddress, baseTexture->width, baseTexture->height, baseTexture->depth, baseInfo->pitch, (uint32)baseTexture->format, (uint32)baseInfo->tileMode, baseSwizzle, baseTexture->isDepth ? 1 : 0, baseInfo->sliceIndex,
+			subTexture->physAddress, subTexture->width, subTexture->height, subInfo->pitch, (uint32)subTexture->format, (uint32)subInfo->tileMode, subSwizzle, subTexture->isDepth ? 1 : 0,
+			byteOffset, yOffset);
+	};
+
+	// basic compatibility checks
+	if (baseInfo->pitch != subInfo->pitch || baseInfo->tileMode != subInfo->tileMode)
+	{
+		logResult("rejected (pitch/tilemode mismatch)", -1);
+		return;
+	}
+	if (baseTexture->IsCompressedFormat() || subTexture->IsCompressedFormat())
+	{
+		logResult("rejected (compressed format)", -1);
+		return;
+	}
+	if (!LatteTexture_IsTexelSizeCompatibleFormat(baseTexture->format, subTexture->format))
+	{
+		logResult("rejected (texel size mismatch)", -1);
+		return;
+	}
+	if (baseTexture->isDepth == subTexture->isDepth && !LatteTexture_IsFormatViewCompatible(baseTexture->format, subTexture->format))
+	{
+		logResult("rejected (format not compatible)", -1);
+		return;
+	}
+	if (LatteTexture_IsBlockedFormatRelation(baseTexture, subTexture))
+	{
+		logResult("rejected (blocked format pair)", -1);
+		return;
+	}
+	if (subTexture->width > baseTexture->width)
+	{
+		logResult("rejected (sub wider than base)", -1);
+		return;
+	}
+	// calculate the y offset
+	const uint32 bytesPerRow = ((uint32)baseInfo->pitch * bpp) / 8;
+	if (bytesPerRow == 0 || (byteOffset % bytesPerRow) != 0)
+	{
+		logResult("rejected (offset is not a whole number of rows)", -1);
+		return;
+	}
+	const sint32 yOffset = (sint32)(byteOffset / bytesPerRow);
+	if ((yOffset + subTexture->height) > baseTexture->height)
+	{
+		logResult("rejected (sub does not fit inside base)", yOffset);
+		return;
+	}
+	// verify that the memory layouts really line up (cached per shape pair)
+	const char* acceptReason = "accepted";
+	uint64 cacheKey = 0xcbf29ce484222325ull;
+	auto mixKey = [&cacheKey](uint64 v) { cacheKey ^= v; cacheKey *= 0x100000001b3ull; };
+	mixKey(baseTexture->width); mixKey(baseTexture->height); mixKey((uint64)baseTexture->format); mixKey((uint64)baseInfo->tileMode); mixKey(baseInfo->pitch); mixKey(baseSwizzle);
+	mixKey(subTexture->width); mixKey(subTexture->height); mixKey((uint64)subTexture->format); mixKey((uint64)subInfo->tileMode); mixKey(subSwizzle);
+	mixKey(byteOffset); mixKey(bpp);
+	bool layoutMatches;
+	auto cacheIt = s_offsetRelVerifyCache.find(cacheKey);
+	if (cacheIt != s_offsetRelVerifyCache.end())
+		layoutMatches = cacheIt->second;
+	else
+	{
+		layoutMatches = _LatteTexture_VerifyOffsetMapping(baseTexture, baseSwizzle, subTexture, subSwizzle, byteOffset, yOffset);
+		// the swizzle stored for a texture is not always reliable, retry while ignoring it
+		if (!layoutMatches)
+			layoutMatches = _LatteTexture_VerifyOffsetMapping(baseTexture, 0, subTexture, 0, byteOffset, yOffset);
+		if (s_offsetRelVerifyCache.size() > 4096)
+			s_offsetRelVerifyCache.clear();
+		s_offsetRelVerifyCache.emplace(cacheKey, layoutMatches);
+	}
+	if (!layoutMatches)
+	{
+		logResult("rejected (layout mismatch)", yOffset);
+		return;
+	}
+	logResult(acceptReason, yOffset);
+
+	LatteTextureRelation* rel = (LatteTextureRelation*)malloc(sizeof(LatteTextureRelation));
+	memset(rel, 0, sizeof(LatteTextureRelation));
+	rel->baseTexture = baseTexture;
+	rel->subTexture = subTexture;
+	rel->baseMipIndex = 0;
+	rel->baseSliceIndex = baseInfo->sliceIndex;
+	rel->mipCount = 1;
+	rel->sliceCount = 1;
+	rel->yOffset = yOffset;
+	rel->isOffsetRelation = true;
+	rel->lastSyncedUpdate = 0;
+	rel->lastSyncedBaseUpdate = 0;
+	baseTexture->list_compatibleRelations.push_back(rel);
+	subTexture->list_compatibleRelations.push_back(rel);
+	// make sure already rendered data is picked up on next use
+	baseTexture->reloadFromDynamicTextures = true;
+	subTexture->reloadFromDynamicTextures = true;
+}
+
+// copy a rectangle between two textures, handling depth<->color conversion. Coordinates are in original (unscaled) texels
+static bool _LatteTexture_CopyRegion(LatteTexture* src, sint32 srcSlice, LatteTexture* dst, sint32 dstSlice, sint32 srcX, sint32 srcY, sint32 dstX, sint32 dstY, sint32 width, sint32 height)
+{
+	if (src->isDepth == dst->isDepth)
+	{
+		LatteTexture_CopySlice(src, srcSlice, 0, dst, dstSlice, 0, srcX, srcY, dstX, dstY, width, height);
+		return true;
+	}
+	return g_renderer->surfaceCopy_copySurfaceRegionWithFormatConversion(src, 0, srcSlice, dst, 0, dstSlice, srcX, srcY, dstX, dstY, width, height);
+}
+
+// sync data between a sub texture and its row range inside the base texture. targetTexture is the texture that is about to be used
+static void LatteTexture_SyncOffsetRelation(LatteTextureRelation* rel, LatteTexture* targetTexture)
+{
+	LatteTexture* baseTexture = rel->baseTexture;
+	LatteTexture* subTexture = rel->subTexture;
+	LatteTextureSliceMipInfo* subInfo = subTexture->sliceMipInfo + subTexture->GetSliceMipArrayIndex(0, 0);
+	LatteTextureSliceMipInfo* baseInfo = baseTexture->sliceMipInfo + baseTexture->GetSliceMipArrayIndex(rel->baseSliceIndex, 0);
+	const bool toBase = (targetTexture == baseTexture);
+	LatteTexture* srcTexture = toBase ? subTexture : baseTexture;
+	LatteTextureSliceMipInfo* srcInfo = toBase ? subInfo : baseInfo;
+	LatteTextureSliceMipInfo* dstInfo = toBase ? baseInfo : subInfo;
+	uint64& lastSyncedSrc = toBase ? rel->lastSyncedUpdate : rel->lastSyncedBaseUpdate;
+
+	if (!srcTexture->isUpdatedOnGPU)
+		return; // data only exists in RAM, the target already loads it from there
+	if (srcInfo->lastDynamicUpdate == 0 || srcInfo->lastDynamicUpdate <= lastSyncedSrc)
+		return; // nothing new since the last sync
+	if (!toBase && srcInfo->lastDynamicUpdate <= dstInfo->lastDynamicUpdate)
+		return; // sub texture was written more recently than the base, don't overwrite it with older data
+	lastSyncedSrc = srcInfo->lastDynamicUpdate;
+
+	if (!LatteTexture_doesEffectiveRescaleRatioMatch(baseTexture, 0, subTexture, 0))
+	{
+		if (s_offsetRelLogBudget > 0)
+		{
+			s_offsetRelLogBudget--;
+			sint32 bw, bh, sw, sh;
+			baseTexture->GetEffectiveSize(bw, bh, 0);
+			subTexture->GetEffectiveSize(sw, sh, 0);
+			cemuLog_log(LogType::Force, "[OffsetTexSync] cannot copy, resolution scale differs (graphic pack). base {:08x} {}x{} -> {}x{}, sub {:08x} {}x{} -> {}x{}", baseTexture->physAddress, baseTexture->width, baseTexture->height, bw, bh, subTexture->physAddress, subTexture->width, subTexture->height, sw, sh);
+		}
+		return;
+	}
+
+	bool copied;
+	if (toBase)
+		copied = _LatteTexture_CopyRegion(subTexture, 0, baseTexture, rel->baseSliceIndex, 0, 0, 0, rel->yOffset, subTexture->width, subTexture->height);
+	else
+		copied = _LatteTexture_CopyRegion(baseTexture, rel->baseSliceIndex, subTexture, 0, 0, rel->yOffset, 0, 0, subTexture->width, subTexture->height);
+
+	static sint32 s_syncLogBudget = 0; // set above 0 to log syncs (diagnostics)
+	if (s_syncLogBudget > 0)
+	{
+		s_syncLogBudget--;
+		cemuLog_log(LogType::Force, "[OffsetTexSync] sync {} {} | sub {:08x} ({}x{} depth {}) base {:08x} ({}x{} depth {}) y {}", toBase ? "sub->base" : "base->sub", copied ? "ok" : "FAILED", subTexture->physAddress, subTexture->width, subTexture->height, subTexture->isDepth ? 1 : 0, baseTexture->physAddress, baseTexture->width, baseTexture->height, baseTexture->isDepth ? 1 : 0, rel->yOffset);
+	}
+
+	if (copied)
+	{
+		targetTexture->isUpdatedOnGPU = true;
+		if (dstInfo->lastDynamicUpdate < srcInfo->lastDynamicUpdate)
+			dstInfo->lastDynamicUpdate = srcInfo->lastDynamicUpdate;
+		// remember the state after the copy so the copied data isn't sent straight back
+		rel->lastSyncedUpdate = std::max(rel->lastSyncedUpdate, subInfo->lastDynamicUpdate);
+		rel->lastSyncedBaseUpdate = std::max(rel->lastSyncedBaseUpdate, baseInfo->lastDynamicUpdate);
+	}
+}
