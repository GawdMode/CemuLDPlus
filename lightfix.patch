+		void Process(const float* input, float* outLeft, float* outRight, size_t count)
+		{
+			constexpr float feedback = 0.70f; // room size: about 0.5 s of reverb, like a normal room
+			constexpr float damp = 0.4f; // high frequencies fade faster, so the tail sounds warmer
+			for (size_t n = 0; n < count; n++)
+			{
+				float in = input[n] * 0.015f;
+				float out[2] = {0.0f, 0.0f};
+				for (sint32 side = 0; side < 2; side++)
