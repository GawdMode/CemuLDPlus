+"""
+
+private val abilitiesById: Map<Int, List<String>> by lazy {
+    ABILITY_DATA.lineSequence()
+        .filter { it.isNotBlank() }
+        .associate { line ->
+            val number = line.substringBefore(':').trim().toInt()
+            number to line.substringAfter(':').split('|').map { it.trim() }.filter { it.isNotEmpty() }
+        }
+}
+
+/** The abilities of a figure, in the order the game lists them (empty if none are known). */
+fun abilitiesOf(number: Int): List<String> = abilitiesById[number] ?: emptyList()
+
+/** Every ability, A to Z. */
+val ALL_ABILITIES: List<String> by lazy {
+    abilitiesById.values.flatten().distinct().sortedBy { it.lowercase() }
+}
