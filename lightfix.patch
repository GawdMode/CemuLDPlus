+	// The firmware's multi-channel reverb isn't emulated. Instead of silencing the effect, run a simple
+	// Freeverb-style room reverb so sounds the game sends to the reverb still get their sense of space.
+	// Output is wet only (the dry sound is mixed separately by the game), on the front left/right channels.
+	class SimpleRoomReverb
+	{
+	  public:
+		explicit SimpleRoomReverb(uint32 sampleRate)
+		{
+			static constexpr sint32 combTuning[8] = {1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617};
+			static constexpr sint32 allpassTuning[4] = {556, 441, 341, 225};
+			static constexpr sint32 stereoSpread = 23;
+			const float scale = (float)sampleRate / 44100.0f;
+			for (sint32 side = 0; side < 2; side++)
+			{
