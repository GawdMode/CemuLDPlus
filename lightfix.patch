+@Composable
+fun rememberToyTagImage(id: Int): ImageBitmap? = rememberRemoteImage(ToyTagImages, id)
+
+@Composable
+fun rememberFranchiseLogo(index: Int): ImageBitmap? = rememberRemoteImage(FranchiseLogos, index)
