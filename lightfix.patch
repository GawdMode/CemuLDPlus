+	// ---- diagnostic: after the user taps "Mark" in the app, log what is playing and how loud for 20 seconds ----
+	static std::atomic<uint64> s_markUntilMs{0};
+	struct AXLevelAcc
+	{
+		double mainEnergy{}; // energy reaching TV main bus channel 0+1 (16-bit units squared, summed)
+		double auxEnergy{};  // energy sent to aux buses (channel 0+1)
+		double rawEnergy{};  // energy after filters, before mixing
+		uint32 samples{};
+		uint16 format{};
+		bool used{};
+	};
+	static AXLevelAcc s_levelVoice[AX_MAX_VOICES];
+	static double s_levelOutEnergy[3]{}; // L, R, center
+	static uint32 s_levelOutSamples = 0;
+	static uint32 s_levelFrames = 0;
+
+	static uint64 _AXDiagMarkNowMs()
+	{
+		return (uint64)std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+	}
+
+	static bool _AXDiagMarking()
+	{
+		return _AXDiagMarkNowMs() < s_markUntilMs.load();
+	}
+
+	static std::string _AXDiagDb(double energy, uint32 samples)
+	{
+		if (samples == 0 || energy <= 0.0)
+			return "-inf";
+		double rms = std::sqrt(energy / (double)samples);
+		return fmt::format("{:.1f}", 20.0 * std::log10(std::max(rms, 1e-9) / 32768.0));
+	}
+
+	void AXDiag_Mark(const char* note)
+	{
+		cemuLog_log(LogType::Force, "[Marker] {} -- logging sound levels for 20 seconds", note ? note : "");
+		// snapshot of all voices the game currently has running
+		for (sint32 i = 0; __AXVPBArrayPtr != nullptr && i < AX_MAX_VOICES; i++)
+		{
+			AXVPB* vpb = __AXVPBArrayPtr + i;
+			AXVPBInternal_t* internal = __AXVPBInternalVoiceArray + i;
+			uint32 state = (uint32)vpb->playbackState;
+			if (state == 0)
+				continue;
+			auto vol = [internal](sint32 bus, sint32 ch) -> uint32 { return _swapEndianU16(internal->deviceMixTV[ch * 4 + bus].vol); };
+			cemuLog_log(LogType::Force, "[Marker] running v{} prio {} fmt {} loop {} samples {:08x} cur {:x} end {:x} | ve {:04x} lpf {}[{:04x} {:04x}] | TV main {:04x} {:04x} {:04x} {:04x} {:04x} {:04x} aux0 {:04x} {:04x}",
+				i, (uint32)vpb->priority, _swapEndianU16(vpb->offsets.format), _swapEndianU16(vpb->offsets.loopFlag), _swapEndianU32(vpb->offsets.samples),
+				_swapEndianU32(vpb->offsets.currentOffset), _swapEndianU32(vpb->offsets.endOffset),
+				(uint32)internal->veVolume, _swapEndianU16(internal->lpf.on), _swapEndianU16(internal->lpf.a0), _swapEndianU16(internal->lpf.b0),
+				vol(0, 0), vol(0, 1), vol(0, 2), vol(0, 3), vol(0, 4), vol(0, 5), vol(1, 0), vol(1, 1));
+		}
+		for (auto& v : s_levelVoice)
+			v = {};
+		s_levelOutEnergy[0] = s_levelOutEnergy[1] = s_levelOutEnergy[2] = 0.0;
+		s_levelOutSamples = 0;
+		s_levelFrames = 0;
+		s_markUntilMs = _AXDiagMarkNowMs() + 20000;
+	}
+
+	static void _AXDiagLevelAccumulateVoice(sint32 idx, AXVPBInternal_t* v, const float* samples, size_t count)
+	{
+		double e = 0.0;
+		for (size_t i = 0; i < count; i++)
+		{
+			double s16 = (double)samples[i] / 256.0;
+			e += s16 * s16;
+		}
+		auto gain = [v](sint32 bus, sint32 ch) -> double {
+			if (((_swapEndianU16(v->deviceMixMaskTV[bus]) >> (ch * 2)) & 3) == 0)
+				return 0.0;
+			return (double)_swapEndianU16(v->deviceMixTV[ch * 4 + bus].vol) / 32768.0;
+		};
+		double gMain = (gain(0, 0) * gain(0, 0) + gain(0, 1) * gain(0, 1)) * 0.5;
+		double gAux = 0.0;
+		for (sint32 bus = 1; bus < AX_BUS_COUNT; bus++)
+			gAux += (gain(bus, 0) * gain(bus, 0) + gain(bus, 1) * gain(bus, 1)) * 0.5;
+		AXLevelAcc& acc = s_levelVoice[idx];
+		acc.used = true;
+		acc.format = _swapEndianU16(v->internalOffsets.format);
+		acc.rawEnergy += e;
+		acc.mainEnergy += e * gMain;
+		acc.auxEnergy += e * gAux;
+		acc.samples += (uint32)count;
+	}
+
+	static void _AXDiagLevelAccumulateOutput()
+	{
+		size_t sampleCount = AXGetInputSamplesPerFrame();
+		const sint32* out = __AXTVOutputBuffer.GetPtr();
+		const sint32 channels[3] = {0, 1, 4};
+		for (sint32 c = 0; c < 3; c++)
+		{
+			const sint32* p = out + channels[c] * sampleCount;
+			double e = 0.0;
+			for (size_t i = 0; i < sampleCount; i++)
+			{
+				double s16 = (double)_swapEndianS32(p[i]);
+				e += s16 * s16;
+			}
+			s_levelOutEnergy[c] += e;
+		}
+		s_levelOutSamples += (uint32)sampleCount;
+		s_levelFrames++;
+		if (s_levelFrames < 83) // about 250ms
+			return;
+		// report: overall output and the loudest voices
+		std::vector<sint32> order;
+		for (sint32 i = 0; i < AX_MAX_VOICES; i++)
+			if (s_levelVoice[i].used && s_levelVoice[i].samples > 0)
+				order.push_back(i);
+		std::sort(order.begin(), order.end(), [](sint32 a, sint32 b) {
+			return s_levelVoice[a].mainEnergy + s_levelVoice[a].auxEnergy > s_levelVoice[b].mainEnergy + s_levelVoice[b].auxEnergy;
+		});
+		std::string line = fmt::format("[AXLevel] out L {} R {} C {} dB |", _AXDiagDb(s_levelOutEnergy[0], s_levelOutSamples), _AXDiagDb(s_levelOutEnergy[1], s_levelOutSamples), _AXDiagDb(s_levelOutEnergy[2], s_levelOutSamples));
+		for (size_t k = 0; k < order.size() && k < 6; k++)
+		{
+			const AXLevelAcc& a = s_levelVoice[order[k]];
+			// voice levels are averaged over the whole 250ms window so they compare directly with the output level
+			line += fmt::format(" v{} fmt{} main {} aux {} (raw {})", order[k], a.format, _AXDiagDb(a.mainEnergy, s_levelOutSamples), _AXDiagDb(a.auxEnergy, s_levelOutSamples), _AXDiagDb(a.rawEnergy, a.samples));
+		}
+		cemuLog_log(LogType::Force, "{}", line);
+		for (auto& v : s_levelVoice)
+			v = {};
+		s_levelOutEnergy[0] = s_levelOutEnergy[1] = s_levelOutEnergy[2] = 0.0;
+		s_levelOutSamples = 0;
+		s_levelFrames = 0;
+	}
+
+	void AXMix_ProcessVoices(AXVPBInternal_t* firstVoice)
+	{
+		bool voiceSeen[AX_MAX_VOICES] = {};
+		const bool marking = _AXDiagMarking();
+		if (firstVoice != nullptr)
+		{
 		size_t sampleCount = AXGetInputSamplesPerFrame();
 		AXVPBInternal_t* internalVoice = firstVoice;
 		cemu_assert_debug(sndGeneric.initParam.frameLength == 0);
 		float tmpSampleBuffer[AX_SAMPLES_MAX];
 		while (internalVoice)
 		{
+			sint32 idx = (sint32)(uint16)internalVoice->index;
+			AXVoiceDiagState* st = (idx >= 0 && idx < AX_MAX_VOICES) ? &s_voiceDiag[idx] : nullptr;
+			if (st)
+			{
+				voiceSeen[idx] = true;
+				uint32 endOffset = internalVoice->internalOffsets.GetEndOffset32();
+				uint32 curOffset = internalVoice->internalOffsets.GetCurrentOffset32();
+				bool voiceLoops = _swapEndianU16(internalVoice->internalOffsets.loopFlag) != 0;
+				if (st->active && st->endOffset != endOffset && !voiceLoops)
+					_AXDiagLogEnd(idx, "replaced");
+				if (!st->active)
+				{
+					s_voiceStopReason[idx] = 0;
+					AXVPB* vpb = __AXVPBArrayPtr + idx;
+					st->active = true;
+					st->format = _swapEndianU16(internalVoice->internalOffsets.format);
+					st->samplesAddr = _swapEndianU32(vpb->offsets.samples);
+					st->endOffset = endOffset;
+					st->startOffset = curOffset;
+					st->tracked = voiceLoops || ((sint64)endOffset - (sint64)curOffset) > 20000;
+					if (st->tracked)
+						_AXDiagLogStart(idx, internalVoice, st->samplesAddr);
+				}
+			}
 			AXVoiceMix_DecodeSamples(internalVoice, tmpSampleBuffer, sampleCount);
+			if (st && st->tracked)
+				st->peakDecoded = std::max(st->peakDecoded, _AXDiagPeak(tmpSampleBuffer, sampleCount));
 			AXVoiceMix_ApplyADSR(internalVoice, tmpSampleBuffer, sampleCount);
+			if (st && st->tracked)
+				st->peakAfterVolume = std::max(st->peakAfterVolume, _AXDiagPeak(tmpSampleBuffer, sampleCount));
 			AXVoiceMix_ApplyBiquad(internalVoice, tmpSampleBuffer, sampleCount);
 			AXVoiceMix_ApplyLowPass(internalVoice, tmpSampleBuffer, sampleCount);
+			if (st)
+			{
+				if (st->tracked)
+					st->peakAfterFilters = std::max(st->peakAfterFilters, _AXDiagPeak(tmpSampleBuffer, sampleCount));
+				st->frames++;
+				st->lastOffset = internalVoice->internalOffsets.GetCurrentOffset32();
+			}
+			if (marking && idx >= 0 && idx < AX_MAX_VOICES)
+				_AXDiagLevelAccumulateVoice(idx, internalVoice, tmpSampleBuffer, sampleCount);
 			AXVoiceMix_MixIntoBuses(internalVoice, tmpSampleBuffer, sampleCount, sampleCount);
 			// next
 			internalVoice = internalVoice->nextToProcess.GetPtr();
 		}
+		}
+		// voices that were active last frame but not processed anymore have stopped
+		for (sint32 i = 0; i < AX_MAX_VOICES; i++)
+		{
+			if (s_voiceDiag[i].active && !voiceSeen[i])
+				_AXDiagLogEnd(i, _AXDiagStopReasonName(s_voiceStopReason[i]));
+		}
 	}
 
