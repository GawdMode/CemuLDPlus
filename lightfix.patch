+extern "C" JNIEXPORT jint JNICALL
+Java_info_cemu_cemu_nativeinterface_NativeEmulatedUSBDevices_getDimensionsFigureSlotNumber([[maybe_unused]] JNIEnv* env, [[maybe_unused]] jclass clazz, jint slot)
+{
