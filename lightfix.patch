+/** The picture behind the Toy Pad: the one chosen in settings, or a drawn star map. */
+@Composable
+fun ToyPadBackground(modifier: Modifier = Modifier) {
+    val context = LocalContext.current.applicationContext
+    val version = ToyPadBackgroundImage.version
+    val custom = remember(version) { ToyPadBackgroundImage.load(context) }
+    Box(modifier = modifier.fillMaxSize()) {
+        if (custom != null) {
+            Image(
+                bitmap = custom,
+                contentDescription = null,
+                contentScale = ContentScale.Crop,
+                modifier = Modifier.fillMaxSize(),
+            )
+            // keep text and pads readable on bright pictures
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(
+                        Brush.verticalGradient(
+                            0f to Color(0x66000000),
+                            0.5f to Color(0x33000000),
+                            1f to Color(0x99000000),
+                        )
+                    )
+            )
+        } else {
+            StarMap(Modifier.fillMaxSize())
+        }
+    }
+}
+
+private class Star(val x: Float, val y: Float, val radius: Float, val alpha: Float)
+private class Constellation(val points: List<Offset>, val edges: List<Pair<Int, Int>>)
+
+@Composable
+private fun StarMap(modifier: Modifier = Modifier) {
+    val stars = remember {
+        val random = Random(23)
+        List(220) {
+            val big = random.nextFloat() < 0.08f
+            Star(
+                x = random.nextFloat(),
+                y = random.nextFloat(),
+                radius = if (big) 1.6f + random.nextFloat() * 1.4f else 0.5f + random.nextFloat() * 0.9f,
+                alpha = 0.25f + random.nextFloat() * 0.75f,
+            )
+        }
+    }
+    val constellations = remember {
+        val random = Random(7)
+        List(9) {
+            val cx = random.nextFloat()
+            val cy = random.nextFloat()
+            val count = 4 + random.nextInt(4)
+            val points = List(count) {
+                Offset(
+                    (cx + (random.nextFloat() - 0.5f) * 0.32f).coerceIn(0.02f, 0.98f),
+                    (cy + (random.nextFloat() - 0.5f) * 0.32f).coerceIn(0.02f, 0.98f),
+                )
+            }
+            val edges = buildList {
+                for (i in 1 until count) add(Pair(i - 1, i))
+                if (count > 4 && random.nextBoolean()) add(Pair(0, count - 1))
+            }
+            Constellation(points, edges)
+        }
+    }
+    Box(
+        modifier = modifier.drawWithCache {
+            val w = size.width
+            val h = size.height
+            val base = Brush.verticalGradient(
+                0f to Color(0xFF040714),
+                0.55f to Color(0xFF081233),
+                1f to Color(0xFF03050F),
+            )
+            val glowRight = Brush.radialGradient(
+                colors = listOf(Color(0x8A2B7BFF), Color(0x302B5BFF), Color.Transparent),
+                center = Offset(w * 1.02f, h * 0.42f),
+                radius = min(w, h) * 0.75f,
+            )
+            val glowLeft = Brush.radialGradient(
+                colors = listOf(Color(0x40613DFF), Color.Transparent),
+                center = Offset(w * 0.08f, h * 0.12f),
+                radius = min(w, h) * 0.6f,
+            )
+            val lineColor = Color(0x5576B8FF)
+            val nodeColor = Color(0xAA9FD0FF)
+            val ringColor = Color(0x2A6FA8FF)
+            onDrawBehind {
+                drawRect(base)
+                drawRect(glowLeft)
+                drawRect(glowRight)
+                // faint star-chart rings
+                val ringCenters = listOf(Offset(w * 0.62f, h * 0.30f), Offset(w * 0.22f, h * 0.78f))
+                ringCenters.forEachIndexed { i, c ->
+                    val r = min(w, h) * (if (i == 0) 0.22f else 0.30f)
+                    drawCircle(ringColor, r, c, style = Stroke(1.2f))
+                    drawCircle(ringColor, r * 0.62f, c, style = Stroke(1f))
+                    for (k in 0 until 12) {
+                        val a = (k / 12f) * 2f * Math.PI.toFloat()
+                        drawLine(ringColor, c + Offset(cos(a) * r * 0.62f, sin(a) * r * 0.62f), c + Offset(cos(a) * r, sin(a) * r), 0.8f)
+                    }
+                }
+                // stars
+                for (s in stars) {
+                    drawCircle(Color.White.copy(alpha = s.alpha), s.radius * density, Offset(s.x * w, s.y * h))
+                }
+                // constellations
+                for (con in constellations) {
+                    for ((a, b) in con.edges) {
+                        val p1 = Offset(con.points[a].x * w, con.points[a].y * h)
+                        val p2 = Offset(con.points[b].x * w, con.points[b].y * h)
+                        drawLine(lineColor, p1, p2, 1.2f * density)
+                    }
+                    for (p in con.points) {
+                        val o = Offset(p.x * w, p.y * h)
+                        drawCircle(Color(0x334FA3FF), 5f * density, o)
+                        drawCircle(nodeColor, 2.2f * density, o)
+                    }
+                }
+            }
+        }
+    )
+}
