diff --git a/src/audio/CubebAPI.cpp b/src/audio/CubebAPI.cpp
index f6d5d516..0a5198de 100644
--- a/src/audio/CubebAPI.cpp
+++ b/src/audio/CubebAPI.cpp
@@ -39,14 +39,19 @@ long CubebAPI::data_cb(cubeb_stream* stream, void* user, const void* inputbuffer
 	const auto size = (size_t)nframes * thisptr->m_channels * (thisptr->m_bitsPerSample/8);
 
 	std::unique_lock lock(thisptr->m_mutex);
+	thisptr->StatsCountBufferLevel(thisptr->m_buffer.size());
 	if (thisptr->m_buffer.empty())
 	{
 		// we got no data, just write silence
 		memset(outputbuffer, 0x00, size);
+		if (thisptr->m_is_playing)
+			thisptr->StatsCountUnderrun(size);
 	}
 	else
 	{
 		const auto copied = std::min(thisptr->m_buffer.size(), size);
+		if (copied < size)
+			thisptr->StatsCountUnderrun(size - copied);
 		memcpy(outputbuffer, thisptr->m_buffer.data(), copied);
 		thisptr->m_buffer.erase(thisptr->m_buffer.begin(), std::next(thisptr->m_buffer.begin(), copied));
 		lock.unlock();
@@ -123,6 +128,7 @@ bool CubebAPI::FeedBlock(sint16* data)
