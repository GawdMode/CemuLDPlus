+@Composable
+private fun lightColor(light: PadLightState): Color {
+    val base = if (light.rgb == 0) Color(0xFF2A2A2A) else Color(0xFF000000.toInt() or light.rgb)
+    return when (light.mode) {
+        2 -> {
+            // flash: blink using the on/off times (assumed ~10 ms units, clamped to something visible)
+            val onMs = (light.param1 * 10).coerceIn(80, 1000)
+            val offMs = (light.param2 * 10).coerceIn(80, 1000)
+            val transition = rememberInfiniteTransition(label = "flash")
+            val phase by transition.animateFloat(
+                initialValue = 0f,
+                targetValue = 1f,
+                animationSpec = infiniteRepeatable(tween(onMs + offMs, easing = LinearEasing), RepeatMode.Restart),
+                label = "flashPhase",
+            )
+            if (phase * (onMs + offMs) < onMs) base else Color(0xFF2A2A2A)
+        }
+
+        3 -> {
+            // random fade: cycle through colors
+            val transition = rememberInfiniteTransition(label = "random")
+            val hue by transition.animateFloat(
+                initialValue = 0f,
+                targetValue = 360f,
+                animationSpec = infiniteRepeatable(tween(3000, easing = LinearEasing), RepeatMode.Restart),
+                label = "randomHue",
+            )
+            Color.hsv(hue, 0.8f, 1f)
+        }
+
+        else -> base
+    }
+}
