+@Composable
+private fun rememberRemoteImage(cache: RemoteImageCache, id: Int): ImageBitmap? {
+    val context = LocalContext.current.applicationContext
+    val image = remember(cache, id) { mutableStateOf(cache.cached(id)) }
+    LaunchedEffect(cache, id) {
+        if (image.value == null && id > 0) image.value = cache.load(context, id)
+    }
+    return image.value
+}
+
+@Composable
+fun rememberFigureImage(id: Int): ImageBitmap? = rememberRemoteImage(FigureImages, id)
