+/** Figure numbers of installed figure files, read once per file. */
+object FigureNumbers {
+    private val byFile = ConcurrentHashMap<String, Int>()
+
+    // keyed by the file's last change too: the game rewrites a vehicle's number when it's rebuilt
+    fun forPath(path: String): Int {
+        val file = File(path)
+        val key = "$path|${file.lastModified()}|${file.length()}"
+        return byFile.getOrPut(key) {
+            try {
+                NativeEmulatedUSBDevices.getDimensionsFigureNumber(path)
+            } catch (_: Throwable) {
+                -1
+            }
+        }
+    }
+}
