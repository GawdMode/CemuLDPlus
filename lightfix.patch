+/** Settings for the Toy Pad on the second screen. */
+object ToyPadScreenSettings {
+    private const val PREFS = "toypad_screen"
+    private const val KEY_FIGURE_PICTURES = "figure_pictures"
+
+    fun figurePicturesEnabled(context: Context): Boolean =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean(KEY_FIGURE_PICTURES, true)
+
+    fun setFigurePicturesEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(KEY_FIGURE_PICTURES, enabled).apply()
+    }
+
+    /** Folder shown as "toypad" inside the app's folder (the one "Open Cemu folder" opens). */
+    fun folder(context: Context): File = File(context.getExternalFilesDir(null) ?: context.filesDir, "toypad")
+}
+
+private fun decodeScaled(file: File, maxSize: Int): Bitmap? {
+    return try {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.path, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        var sample = 1
+        while (bounds.outWidth / (sample * 2) >= maxSize && bounds.outHeight / (sample * 2) >= maxSize) sample *= 2
+        BitmapFactory.decodeFile(file.path, BitmapFactory.Options().apply { inSampleSize = sample })
+    } catch (_: Throwable) {
+        null
+    }
+}
+
+/**
+ * Pictures downloaded once onto the device and kept in a folder under "toypad", by figure number.
+ * A picture already in that folder (named like 1.png) is used as is, so people can put in their own.
+ * Nothing is bundled with the app.
+ */
+class RemoteImageCache(
+    private val subfolder: String,
+    private val maxSize: Int,
+    private val transform: ((Int, Bitmap) -> Bitmap)? = null,
+    private val urlFor: (Int) -> String?,
+) {
+    private val memory = LruCache<Int, ImageBitmap>(240)
+    private val missing = ConcurrentHashMap.newKeySet<Int>() // not available at the source
+    private val failedAt = ConcurrentHashMap<Int, Long>() // download failed (offline?), retry later
+    private val locks = ConcurrentHashMap<Int, Mutex>()
+
+    fun folder(context: Context): File = File(ToyPadScreenSettings.folder(context), subfolder)
+
+    fun cached(id: Int): ImageBitmap? = if (id > 0) memory.get(id) else null
+
+    suspend fun load(context: Context, id: Int): ImageBitmap? {
+        if (id <= 0) return null
+        memory.get(id)?.let { return it }
+        val lock = locks.getOrPut(id) { Mutex() }
+        return lock.withLock {
+            memory.get(id) ?: withContext(Dispatchers.IO) {
+                val dir = folder(context)
+                val local = listOf("png", "webp", "jpg", "jpeg")
+                    .map { File(dir, "$id.$it") }
+                    .firstOrNull { it.isFile && it.length() > 0 }
+                val file = local ?: if (ToyPadScreenSettings.figurePicturesEnabled(context)) download(dir, id) else null
+                file?.let { decodeScaled(it, maxSize) }
+                    ?.let { bitmap -> transform?.let { runCatching { it(id, bitmap) }.getOrNull() } ?: bitmap }
+                    ?.asImageBitmap()?.also { memory.put(id, it) }
+            }
+        }
+    }
+
+    private suspend fun download(dir: File, id: Int): File? {
+        val url = urlFor(id) ?: return null
+        if (id in missing) return null
+        val lastFail = failedAt[id]
+        if (lastFail != null && System.currentTimeMillis() - lastFail < RETRY_AFTER_MS) return null
+        return downloads.withPermit {
+            try {
+                dir.mkdirs()
+                val connection = URL(url).openConnection() as HttpURLConnection
+                connection.connectTimeout = 8000
+                connection.readTimeout = 15000
+                connection.setRequestProperty("Accept", "image/png,image/webp,image/*")
+                try {
+                    when (connection.responseCode) {
+                        200 -> {
+                            val part = File(dir, "$id.png.part")
+                            connection.inputStream.use { input -> part.outputStream().use { input.copyTo(it) } }
+                            val out = File(dir, "$id.png")
+                            if (part.length() > 0 && part.renameTo(out)) {
+                                failedAt.remove(id)
+                                out
+                            } else {
+                                part.delete()
+                                failedAt[id] = System.currentTimeMillis()
+                                null
+                            }
+                        }
+
+                        404 -> {
+                            missing.add(id)
+                            null
+                        }
+
+                        else -> {
+                            failedAt[id] = System.currentTimeMillis()
+                            null
+                        }
+                    }
+                } finally {
+                    connection.disconnect()
+                }
+            } catch (_: Throwable) {
+                failedAt[id] = System.currentTimeMillis()
+                null
+            }
+        }
+    }
+
+    companion object {
+        private const val RETRY_AFTER_MS = 60_000L
+        private val downloads = Semaphore(4)
+    }
+}
