+@Composable
+private fun SidePad(
+    slotIndices: IntArray,
+    innerOnRight: Boolean,
+    light: PadLightState,
+    slots: List<SlotInfo?>,
+    selectedSlot: Int?,
+    moveSource: Int?,
+    onSlotTapped: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    PadBackground(light = light, shape = RoundedCornerShape(20.dp), modifier = modifier) {
+        BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
+            val size: Dp = sideSlotSize(maxWidth.value, maxHeight.value).dp
+            val outerX: Dp = if (innerOnRight) 0.dp else maxWidth - size
+            val innerX: Dp = if (innerOnRight) maxWidth - size else 0.dp
+            val positions = listOf(
+                outerX to 0.dp,
+                innerX to (maxHeight - size) / 2,
+                outerX to maxHeight - size,
+            )
+            slotIndices.forEachIndexed { position, index ->
+                val (x, y) = positions[position]
+                SlotTile(
+                    slot = slots[index],
+                    isSelected = selectedSlot == index,
+                    isMoveSource = moveSource == index,
+                    onTap = { onSlotTapped(index) },
+                    modifier = Modifier
+                        .offset(x = x, y = y)
+                        .size(size),
+                )
+            }
+        }
+    }
+}
