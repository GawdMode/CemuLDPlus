+			_swapEndianU16(v->lpf.on), _swapEndianU16(v->lpf.a0), _swapEndianU16(v->lpf.b0), _swapEndianU16(v->biquad.on),
+			_swapEndianU16(v->deviceMixMaskTV[0]), vol(0, 0), vol(0, 1), vol(0, 2), vol(0, 3), vol(0, 4), vol(0, 5), auxInfo, drcMask);
