+	// Cemu LD+: phones mix fast CPU cores with slow power-saving ones. Works out which host CPUs are which (once).
+	// Returns false when there is no clear split, in which case everything is left to the OS.
+	bool __CemuGetHostCpuSplit(uint64& fastMask, uint64& slowMask)
+	{
+#if defined(__linux__)
+		static uint64 s_fastMask = 0, s_slowMask = 0;
+		static std::once_flag s_once;
+		std::call_once(s_once, []() {
+			const long cpuCount = std::clamp<long>(sysconf(_SC_NPROCESSORS_CONF), 0, 64);
+			std::vector<uint64> maxKHz((size_t)cpuCount, 0);
+			uint64 fastest = 0;
+			for (long cpu = 0; cpu < cpuCount; cpu++)
+			{
+				std::ifstream f(fmt::format("/sys/devices/system/cpu/cpu{}/cpufreq/cpuinfo_max_freq", cpu));
+				uint64 v = 0;
+				if (f >> v)
+					maxKHz[(size_t)cpu] = v;
+				fastest = std::max(fastest, maxKHz[(size_t)cpu]);
+			}
+			std::string speeds;
+			uint32 fastCount = 0, knownCount = 0;
+			uint64 fast = 0, slow = 0;
+			for (long cpu = 0; cpu < cpuCount; cpu++)
+			{
+				if (maxKHz[(size_t)cpu] == 0)
+					continue;
+				knownCount++;
+				speeds.append(fmt::format("{}{}:{}", speeds.empty() ? "" : " ", cpu, maxKHz[(size_t)cpu] / 1000));
+				if (maxKHz[(size_t)cpu] * 10 >= fastest * 7)
+				{
+					fast |= (1ull << cpu);
+					fastCount++;
+				}
+				else
+					slow |= (1ull << cpu);
+			}
+			cemuLog_log(LogType::Force, "[CPU] host CPU top speeds in MHz (cpu:speed): {}", speeds.empty() ? "unknown" : speeds);
+			if (fastCount < 3 || fastCount >= knownCount)
+			{
+				cemuLog_log(LogType::Force, "[CPU] no clear split between fast and slow host CPUs, leaving thread placement to the system");
+				return;
+			}
+			s_fastMask = fast;
+			s_slowMask = slow;
+		});
+		fastMask = s_fastMask;
+		slowMask = s_slowMask;
+		return s_fastMask != 0 && s_slowMask != 0;
+#else
+		fastMask = slowMask = 0;
+		return false;
+#endif
+	}
