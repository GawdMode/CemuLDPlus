+// Cemu LD+: hitch monitor. Times what each frame spends its time on and writes slow frames ("hitches") and a summary
+// every 10 seconds to the log, so stutter can be traced to its cause.
+enum class LatteHitch : uint32
+{
+	WaitForGame,   // render thread had no new commands from the emulated CPU (the game itself was busy)
+	ShaderCreate,  // translating new shaders
+	ShaderCompile, // compiling a shader on the render thread because it was needed right away
+	PipelineSync,  // building a pipeline on the render thread
+	TextureUpload, // decoding and uploading texture data from game memory
+	Readback,      // copying rendered textures back for the game, and waiting for that
+	Fence,         // command processor waiting for a memory fence or semaphore
+	GpuWait,       // waiting for the GPU to finish earlier work
+	Present,       // showing the frame (swapchain, vsync, waiting for flip)
+	DiscRead,      // reading game files (any thread)
+	PipelineBackground, // pipelines built on the background compile threads (counted when they finish)
+	PipelineRepeat,     // pipelines that had to be made again although they were made before in this session
+	Count
+};
+uint64 LatteHitch_NowUs();
+void LatteHitch_Add(LatteHitch category, uint64 microseconds);
+void LatteHitch_AddBytesRead(uint64 bytes);
+void LatteHitch_CountNewTexture();
+void LatteHitch_FrameEnd();
+
+class LatteHitchScope
+{
+  public:
+	explicit LatteHitchScope(LatteHitch category) : m_category(category), m_start(LatteHitch_NowUs()) {}
+	~LatteHitchScope() { LatteHitch_Add(m_category, LatteHitch_NowUs() - m_start); }
+	LatteHitchScope(const LatteHitchScope&) = delete;
+	LatteHitchScope& operator=(const LatteHitchScope&) = delete;
+
+  private:
+	LatteHitch m_category;
+	uint64 m_start;
+};
