+extern "C" JNIEXPORT jint JNICALL
+Java_info_cemu_cemu_nativeinterface_NativeEmulatedUSBDevices_getDimensionsFigureSlotNumber([[maybe_unused]] JNIEnv* env, [[maybe_unused]] jclass clazz, jint slot)
+{
+	if (slot < 0 || slot >= (jint)NativeEmulatedUSBDevices::g_dimensionSlots.size())
+		return -1;
+	if (const auto& opt = NativeEmulatedUSBDevices::g_dimensionSlots.at(slot))
+		return (jint)opt->number;
+	return -1;
+}
+
+extern "C" JNIEXPORT jint JNICALL
+Java_info_cemu_cemu_nativeinterface_NativeEmulatedUSBDevices_getDimensionsFigureNumber(JNIEnv* env, [[maybe_unused]] jclass clazz, jstring path)
+{
+	// read only the figure's data to find which character/vehicle it is
+	std::unique_ptr<FileStream> file(FileStream::openFile2(JNIUtils::FromJString(env, path), false));
+	if (!file)
+		return -1;
+	std::array<uint8, 0x2D * 0x04> data{};
+	if (file->readData(data.data(), data.size()) != data.size())
+		return -1;
+	return (jint)nsyshid::g_dimensionstoypad.GetFigureIdFromData(data);
+}
+
+extern "C" JNIEXPORT jintArray JNICALL
+Java_info_cemu_cemu_nativeinterface_NativeEmulatedUSBDevices_getDimensionsPadLights(JNIEnv* env, [[maybe_unused]] jclass clazz)
+{
+	// 4 values per pad (center, left, right): rgb, mode, param1 | param2 << 8, count
+	auto lights = nsyshid::g_dimensionstoypad.GetPadLights();
+	jint values[12];
+	for (size_t i = 0; i < 3; i++)
+	{
+		values[i * 4 + 0] = (jint)lights[i].rgb;
+		values[i * 4 + 1] = (jint)lights[i].mode;
+		values[i * 4 + 2] = (jint)lights[i].param1 | ((jint)lights[i].param2 << 8);
+		values[i * 4 + 3] = (jint)lights[i].count;
+	}
+	jintArray result = env->NewIntArray(12);
+	env->SetIntArrayRegion(result, 0, 12, values);
+	return result;
+}
