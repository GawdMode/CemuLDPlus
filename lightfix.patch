+		AXVPBInternal_t* internal = __AXVPBInternalVoiceArray + voiceIndex;
+		std::unique_lock _l(s_axHistMutex);
+		uint8& pos = s_axHistPos[voiceIndex];
+		AXDiagCall& prev = s_axHist[voiceIndex][(pos + AXDIAG_HISTORY - 1) % AXDIAG_HISTORY];
+		bool isPoll = (type == AXDIAG_GETOFFSETS || type == AXDIAG_GETCUREX);
+		if (isPoll && prev.type == type)
+		{
+			// collapse repeated polling into one entry
+			prev.repeat++;
+			prev.timeMs = _AXDiagNowMs();
+			prev.v[0] = v0; prev.v[1] = v1; prev.v[2] = v2; prev.v[3] = v3;
+			prev.absCur = internal->internalOffsets.GetCurrentOffset32();
+			prev.absEnd = internal->internalOffsets.GetEndOffset32();
+			return;
+		}
+		AXDiagCall& c = s_axHist[voiceIndex][pos];
+		c.timeMs = _AXDiagNowMs();
+		c.type = type;
+		c.repeat = 1;
+		c.v[0] = v0; c.v[1] = v1; c.v[2] = v2; c.v[3] = v3;
+		c.absCur = internal->internalOffsets.GetCurrentOffset32();
+		c.absEnd = internal->internalOffsets.GetEndOffset32();
+		pos = (pos + 1) % AXDIAG_HISTORY;
+	}
