+
+// slot index -> pad number used by the emulated Toy Pad (1 = center, 2 = left, 3 = right)
+private val SLOT_PADS = intArrayOf(2, 1, 3, 2, 2, 3, 3)
+
+// slots of each side pad, from top to bottom (the middle one sits closer to the center pad)
+private val LEFT_SLOTS = intArrayOf(0, 4, 3)
+private val RIGHT_SLOTS = intArrayOf(2, 5, 6)
+private const val CENTER_SLOT = 1
+
+private val TextOnBackground = Color(0xFFF2F5FF)
+private val TextDim = Color(0xFFB8C3E6)
+private val Bronze = Color(0xFFD9893A)
+private val Amber = Color(0xFFFFC107)
+private val OnPadColor = Color(0xFF43E0B0)
+
+private data class SlotInfo(val name: String, val number: Int)
+
+private data class PadLightState(val rgb: Int, val mode: Int, val param1: Int, val param2: Int)
+
+private data class FigureEntry(val figure: NativeEmulatedUSBDevices.InstalledFigure, val number: Int)
+
+private fun readSlots(): List<SlotInfo?> =
+    List(NativeEmulatedUSBDevices.MAX_DIMENSIONS_SLOTS) { index ->
+        val name = NativeEmulatedUSBDevices.getDimensionsFigureSlot(index) ?: return@List null
+        val number = try {
+            NativeEmulatedUSBDevices.getDimensionsFigureSlotNumber(index)
+        } catch (_: Throwable) {
+            -1
+        }
+        SlotInfo(name, number)
+    }
+
+private fun readLights(): List<PadLightState> {
+    val raw = try {
+        NativeEmulatedUSBDevices.getDimensionsPadLights()
+    } catch (_: Throwable) {
+        IntArray(12)
+    }
+    return List(3) { i ->
+        PadLightState(
+            rgb = raw.getOrElse(i * 4) { 0 },
+            mode = raw.getOrElse(i * 4 + 1) { 0 },
+            param1 = raw.getOrElse(i * 4 + 2) { 0 } and 0xFF,
+            param2 = (raw.getOrElse(i * 4 + 2) { 0 } shr 8) and 0xFF,
+        )
+    }
+}
+
+private fun readFigures(): List<FigureEntry> =
+    NativeEmulatedUSBDevices.getInstalledDimensionsMiniFigures()
+        .map { FigureEntry(it, FigureNumbers.forPath(it.path)) }
+        .sortedWith(compareBy({ it.number >= 1000 }, { it.figure.name.lowercase() }))
+
+// light index for a pad number: 1 = center -> 0, 2 = left -> 1, 3 = right -> 2
+private fun lightIndexForPad(pad: Int) = (pad - 1).coerceIn(0, 2)
+
+@Composable
+fun ToyPadScreen() {
+    var slots by remember { mutableStateOf(readSlots()) }
+    var lights by remember { mutableStateOf(readLights()) }
+    var figures by remember { mutableStateOf(readFigures()) }
+    var selectedSlot by remember { mutableStateOf<Int?>(null) }
+    var selectedFigure by remember { mutableStateOf<FigureEntry?>(null) }
+    var moveSource by remember { mutableStateOf<Int?>(null) }
+    var errorMessage by remember { mutableStateOf<String?>(null) }
+
+    LaunchedEffect(Unit) {
+        var tick = 0
+        while (true) {
+            slots = readSlots()
+            lights = readLights()
+            if (tick % 16 == 0) {
+                figures = readFigures()
+            }
+            tick++
+            delay(250)
+        }
+    }
+
+    fun refresh() {
+        slots = readSlots()
+    }
+
+    fun clearSelection() {
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    fun loadFigure(entry: FigureEntry, index: Int) {
+        val ok = NativeEmulatedUSBDevices.loadDimensionsFigure(entry.figure.path, SLOT_PADS[index], index)
+        errorMessage = if (ok) null else "Couldn't place ${entry.figure.name}"
+        clearSelection()
+        refresh()
+    }
+
+    fun cancelMove() {
+        moveSource?.let { NativeEmulatedUSBDevices.cancelRemoveDimensionsFigure(it) }
+        moveSource = null
+        clearSelection()
+        refresh()
+    }
+
+    fun onSlotTapped(index: Int) {
+        errorMessage = null
+        val source = moveSource
+        if (source != null) {
+            if (source == index) {
+                cancelMove()
+            } else {
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[source], source)
+                moveSource = null
+                clearSelection()
+                refresh()
+            }
+            return
+        }
+        val figure = selectedFigure
+        if (figure != null) {
+            loadFigure(figure, index)
+            return
+        }
+        selectedSlot = if (selectedSlot == index) null else index
+    }
+
+    fun onFigureTapped(entry: FigureEntry) {
+        errorMessage = null
+        if (moveSource != null) return
+        val slot = selectedSlot
+        if (slot != null) {
+            loadFigure(entry, slot)
+            return
+        }
+        selectedFigure = if (selectedFigure == entry) null else entry
+    }
+
+    fun onRemove(index: Int) {
+        NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[index], index)
+        clearSelection()
+        refresh()
+    }
+
+    fun onMove(index: Int) {
+        NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(index)
+        moveSource = index
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    val onPadNumbers = slots.mapNotNull { it?.number }.toSet()
+    val characters = figures.filter { it.number < 1000 }
+    val vehicles = figures.filter { it.number >= 1000 }
+
+    Box(modifier = Modifier.fillMaxSize()) {
+        ToyPadBackground()
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = 12.dp, vertical = 10.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    text = "LEGO Dimensions Toy Pad",
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.SemiBold,
+                    color = TextOnBackground,
+                )
+            }
+
+            // the pad
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.35f),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                SidePad(
+                    slotIndices = LEFT_SLOTS,
+                    innerOnRight = true,
+                    light = lights[lightIndexForPad(2)],
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    moveSource = moveSource,
+                    onSlotTapped = ::onSlotTapped,
+                    modifier = Modifier
+                        .weight(1f)
+                        .fillMaxHeight(),
+                )
+                CenterPad(
+                    light = lights[lightIndexForPad(1)],
+                    slot = slots[CENTER_SLOT],
+                    isSelected = selectedSlot == CENTER_SLOT,
+                    isMoveSource = moveSource == CENTER_SLOT,
+                    onTap = { onSlotTapped(CENTER_SLOT) },
+                    modifier = Modifier
+                        .weight(0.95f)
+                        .fillMaxHeight(),
+                )
+                SidePad(
+                    slotIndices = RIGHT_SLOTS,
+                    innerOnRight = false,
+                    light = lights[lightIndexForPad(3)],
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    moveSource = moveSource,
+                    onSlotTapped = ::onSlotTapped,
+                    modifier = Modifier
+                        .weight(1f)
+                        .fillMaxHeight(),
+                )
+            }
+
+            // what to do next
+            ActionBar(
+                slots = slots,
+                selectedSlot = selectedSlot,
+                selectedFigure = selectedFigure,
+                moveSource = moveSource,
+                errorMessage = errorMessage,
+                onMove = ::onMove,
+                onRemove = ::onRemove,
+                onCancel = {
+                    if (moveSource != null) cancelMove() else clearSelection()
+                },
+            )
+
+            // figure collection
+            if (figures.isEmpty()) {
+                Text(
+                    text = "No figures yet. Create figures in the emulated USB devices menu in the game's menu.",
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = TextOnBackground,
+                )
+            }
+            LazyVerticalGrid(
+                columns = GridCells.Adaptive(minSize = 84.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+                contentPadding = PaddingValues(8.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                if (characters.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Characters (${characters.size})") }
+                    items(characters, key = { it.figure.path }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.number > 0 && entry.number in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                        )
+                    }
+                }
+                if (vehicles.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Vehicles and gadgets (${vehicles.size})") }
+                    items(vehicles, key = { it.figure.path }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.number in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+@Composable
+private fun SectionLabel(text: String) {
+    Text(
+        text = text,
+        color = TextDim,
+        fontSize = 13.sp,
+        fontWeight = FontWeight.SemiBold,
+        modifier = Modifier.padding(start = 4.dp, top = 2.dp, bottom = 2.dp),
+    )
+}
+
+@Composable
+private fun ActionBar(
+    slots: List<SlotInfo?>,
+    selectedSlot: Int?,
+    selectedFigure: FigureEntry?,
+    moveSource: Int?,
+    errorMessage: String?,
+    onMove: (Int) -> Unit,
+    onRemove: (Int) -> Unit,
+    onCancel: () -> Unit,
+) {
+    Row(
+        modifier = Modifier
+            .fillMaxWidth()
+            .height(48.dp)
+            .clip(RoundedCornerShape(14.dp))
+            .background(Color(0x99060B1E))
+            .padding(horizontal = 10.dp),
+        verticalAlignment = Alignment.CenterVertically,
+        horizontalArrangement = Arrangement.spacedBy(8.dp),
+    ) {
+        val prompt: String
+        var showCancel = false
+        var occupiedSlot: Int? = null
+        when {
+            errorMessage != null -> prompt = errorMessage
+            moveSource != null -> {
+                prompt = "Tap where to put ${slots[moveSource]?.name ?: "the figure"}"
+                showCancel = true
+            }
+
+            selectedFigure != null -> {
+                prompt = "Tap a spot on the pad for ${selectedFigure.figure.name}"
+                showCancel = true
+            }
+
+            selectedSlot != null && slots[selectedSlot] == null -> {
+                prompt = "Pick a figure below for this spot"
+                showCancel = true
+            }
+
+            selectedSlot != null -> {
+                prompt = slots[selectedSlot]?.name ?: ""
+                occupiedSlot = selectedSlot
+            }
+
+            else -> prompt = "Tap a spot on the pad, or a figure below"
+        }
+        Text(
+            text = prompt,
+            modifier = Modifier.weight(1f),
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+            style = MaterialTheme.typography.bodyLarge,
+            color = TextOnBackground,
+        )
+        val actionSlot: Int? = occupiedSlot
+        val outlinedColors = ButtonDefaults.outlinedButtonColors(contentColor = TextOnBackground)
+        if (actionSlot != null) {
+            Button(onClick = { onMove(actionSlot) }) { Text("Move") }
+            OutlinedButton(onClick = { onRemove(actionSlot) }, colors = outlinedColors) { Text("Remove") }
+            OutlinedButton(onClick = onCancel, colors = outlinedColors) { Text("Done") }
+        } else if (showCancel) {
+            OutlinedButton(onClick = onCancel, colors = outlinedColors) { Text("Cancel") }
+        }
+    }
+}
+
+@Composable
+private fun lightColor(light: PadLightState): Color {
+    val base = if (light.rgb == 0) Color(0xFF2A2A2A) else Color(0xFF000000.toInt() or light.rgb)
+    return when (light.mode) {
+        2 -> {
+            // flash: blink using the on/off times (assumed ~10 ms units, clamped to something visible)
+            val onMs = (light.param1 * 10).coerceIn(80, 1000)
+            val offMs = (light.param2 * 10).coerceIn(80, 1000)
+            val transition = rememberInfiniteTransition(label = "flash")
+            val phase by transition.animateFloat(
+                initialValue = 0f,
+                targetValue = 1f,
+                animationSpec = infiniteRepeatable(tween(onMs + offMs, easing = LinearEasing), RepeatMode.Restart),
+                label = "flashPhase",
+            )
+            if (phase * (onMs + offMs) < onMs) base else Color(0xFF2A2A2A)
+        }
+
+        3 -> {
+            // random fade: cycle through colors
+            val transition = rememberInfiniteTransition(label = "random")
+            val hue by transition.animateFloat(
+                initialValue = 0f,
+                targetValue = 360f,
+                animationSpec = infiniteRepeatable(tween(3000, easing = LinearEasing), RepeatMode.Restart),
+                label = "randomHue",
+            )
+            Color.hsv(hue, 0.8f, 1f)
+        }
+
+        else -> base
+    }
+}
+
+@Composable
+private fun PadBackground(
+    light: PadLightState,
+    shape: Shape,
+    modifier: Modifier = Modifier,
+    content: @Composable () -> Unit,
+) {
+    val glow = lightColor(light)
+    val isLit = light.rgb != 0 || light.mode == 3
+    Box(
+        modifier = modifier
+            .clip(shape)
+            .background(Color(0xB30A1028))
+            .background(
+                if (isLit) Brush.radialGradient(listOf(glow.copy(alpha = 0.55f), glow.copy(alpha = 0.18f)))
+                else Brush.radialGradient(listOf(Color.Transparent, Color.Transparent))
+            )
+            .border(3.dp, if (isLit) glow else Color(0x55FFFFFF), shape)
+            .padding(6.dp),
+        contentAlignment = Alignment.Center,
+    ) {
+        content()
+    }
+}
+
+/** Biggest circle size for three spots in a zig-zag (two on the outer edge, one in the middle on the inner edge). */
+private fun sideSlotSize(width: Float, height: Float, gap: Float = 4f): Float {
+    var size = kotlin.math.min((height - gap) / 2f, width)
+    while (size > 12f) {
+        val dx = width - size
+        val dy = height / 2f - size / 2f
+        if (dx * dx + dy * dy >= (size + gap) * (size + gap)) break
+        size -= 1f
+    }
+    return size
+}
+
+@Composable
+private fun SidePad(
+    slotIndices: IntArray,
+    innerOnRight: Boolean,
+    light: PadLightState,
+    slots: List<SlotInfo?>,
+    selectedSlot: Int?,
+    moveSource: Int?,
+    onSlotTapped: (Int) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    PadBackground(light = light, shape = RoundedCornerShape(20.dp), modifier = modifier) {
+        BoxWithConstraints(modifier = Modifier.fillMaxSize()) {
+            val size: Dp = sideSlotSize(maxWidth.value, maxHeight.value).dp
+            val outerX: Dp = if (innerOnRight) 0.dp else maxWidth - size
+            val innerX: Dp = if (innerOnRight) maxWidth - size else 0.dp
+            val positions = listOf(
+                outerX to 0.dp,
+                innerX to (maxHeight - size) / 2,
+                outerX to maxHeight - size,
+            )
+            slotIndices.forEachIndexed { position, index ->
+                val (x, y) = positions[position]
+                SlotTile(
+                    slot = slots[index],
+                    isSelected = selectedSlot == index,
+                    isMoveSource = moveSource == index,
+                    onTap = { onSlotTapped(index) },
+                    modifier = Modifier
+                        .offset(x = x, y = y)
+                        .size(size),
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun CenterPad(
+    light: PadLightState,
+    slot: SlotInfo?,
+    isSelected: Boolean,
+    isMoveSource: Boolean,
+    onTap: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    PadBackground(light = light, shape = RoundedCornerShape(28.dp), modifier = modifier) {
+        BoxWithConstraints(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            val size = min(maxWidth * 0.96f, maxHeight * 0.86f)
+            SlotTile(
+                slot = slot,
+                isSelected = isSelected,
+                isMoveSource = isMoveSource,
+                onTap = onTap,
+                modifier = Modifier.size(size),
+            )
+        }
+    }
+}
+
+@Composable
+private fun Portrait(
+    number: Int,
+    name: String?,
+    ringColor: Color,
+    ringWidth: Dp,
+    modifier: Modifier = Modifier,
+    emptyLabel: String? = null,
+) {
+    val image = if (number > 0) rememberFigureImage(number) else null
+    // characters stand on their Toy Tag; the tag's own outline replaces the plain ring unless the spot is highlighted
+    val tag = if (name != null && number in 1..999) rememberToyTagImage(number) else null
+    val showRing = tag == null || ringColor != Bronze
+    Box(
+        modifier = modifier
+            .clip(CircleShape)
+            .background(Brush.radialGradient(listOf(Color(0xFF2A4785), Color(0xFF0B1430))))
+            .then(if (showRing) Modifier.border(ringWidth, ringColor, CircleShape) else Modifier),
+        contentAlignment = Alignment.Center,
+    ) {
+        if (tag != null) {
+            Image(
+                bitmap = tag,
+                contentDescription = null,
+                contentScale = ContentScale.FillBounds,
+                modifier = Modifier.fillMaxSize(),
+            )
+        }
+        when {
+            name == null -> Text(
+                text = emptyLabel ?: "+",
+                color = Color(0xCCFFFFFF),
+                fontSize = 30.sp,
+                fontWeight = FontWeight.Light,
+            )
+
+            image != null -> Image(
+                bitmap = image,
+                contentDescription = name,
+                contentScale = ContentScale.Fit,
+                modifier = Modifier
+                    .fillMaxSize()
+                    .padding(ringWidth + 3.dp),
+            )
+
+            else -> Text(
+                text = name,
+                color = Color.White,
+                textAlign = TextAlign.Center,
+                fontSize = 12.sp,
+                fontWeight = FontWeight.Medium,
+                maxLines = 3,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.padding(6.dp),
+            )
+        }
+    }
+}
+
+@Composable
+private fun SlotTile(
+    slot: SlotInfo?,
+    isSelected: Boolean,
+    isMoveSource: Boolean,
+    onTap: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val ringColor = when {
+        isMoveSource -> Amber
+        isSelected -> Color.White
+        slot != null -> Bronze
+        else -> Color(0x66FFFFFF)
+    }
+    Box(
+        modifier = modifier
+            .clip(CircleShape)
+            .clickable(onClick = onTap),
+        contentAlignment = Alignment.Center,
+    ) {
+        Portrait(
+            number = slot?.number ?: -1,
+            name = slot?.name,
+            ringColor = ringColor,
+            ringWidth = if (isSelected || isMoveSource) 4.dp else 3.dp,
+            modifier = Modifier.fillMaxSize(),
+        )
+        if (isMoveSource) {
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .clip(CircleShape)
+                    .background(Color(0x55FFC107))
+            )
+        }
+    }
+}
+
+@Composable
+private fun FigureTile(
+    entry: FigureEntry,
+    isSelected: Boolean,
+    isOnPad: Boolean,
+    onTap: () -> Unit,
+) {
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(14.dp))
+            .background(if (isSelected) Color(0x663D8BFF) else Color.Transparent)
+            .clickable(onClick = onTap)
+            .padding(vertical = 4.dp, horizontal = 2.dp),
+        horizontalAlignment = Alignment.CenterHorizontally,
+        verticalArrangement = Arrangement.spacedBy(3.dp),
+    ) {
+        Box(modifier = Modifier.size(66.dp)) {
+            Portrait(
+                number = entry.number,
+                name = entry.figure.name,
+                ringColor = if (isSelected) Color.White else Bronze,
+                ringWidth = if (isSelected) 3.dp else 2.dp,
+                modifier = Modifier.fillMaxSize(),
+            )
+            if (isOnPad) {
+                Box(
+                    modifier = Modifier
+                        .align(Alignment.BottomEnd)
+                        .size(20.dp)
+                        .clip(CircleShape)
+                        .background(OnPadColor)
+                        .border(2.dp, Color(0xFF0B1430), CircleShape),
+                    contentAlignment = Alignment.Center,
+                ) {
+                    Text(text = "✓", color = Color(0xFF0B1430), fontSize = 11.sp, fontWeight = FontWeight.Bold)
+                }
+            }
+        }
+        Text(
+            text = entry.figure.name,
+            color = if (isOnPad) OnPadColor else TextOnBackground,
+            fontSize = 11.sp,
+            lineHeight = 13.sp,
+            textAlign = TextAlign.Center,
+            maxLines = 2,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
