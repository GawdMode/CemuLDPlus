+	// Cemu LD+: phones mix fast CPU cores with slow power-saving ones, and often have one or two CPUs that are faster
+	// still (the AYN Thor: 3 slow, 4 fast and 1 fastest). Works out which host CPUs are which (once).
+	struct HostCpuTiers
+	{
+		uint64 fastest = 0; // CPUs at the top speed
+		uint64 fast = 0;    // CPUs at 70% of the top speed or more (includes the fastest ones)
+		uint64 slow = 0;    // everything else
+	};
+
+	static const HostCpuTiers& _GetHostCpuTiers()
+	{
+		static HostCpuTiers s_tiers;
+		static std::once_flag s_once;
+		std::call_once(s_once, []() {
+#if defined(__linux__)
+			const long cpuCount = std::clamp<long>(sysconf(_SC_NPROCESSORS_CONF), 0, 64);
+			std::vector<uint64> maxKHz((size_t)cpuCount, 0);
+			uint64 top = 0;
+			for (long cpu = 0; cpu < cpuCount; cpu++)
+			{
+				std::ifstream f(fmt::format("/sys/devices/system/cpu/cpu{}/cpufreq/cpuinfo_max_freq", cpu));
+				uint64 v = 0;
+				if (f >> v)
+					maxKHz[(size_t)cpu] = v;
+				top = std::max(top, maxKHz[(size_t)cpu]);
+			}
+			std::string speeds;
+			uint32 fastCount = 0, knownCount = 0;
+			HostCpuTiers tiers;
+			for (long cpu = 0; cpu < cpuCount; cpu++)
+			{
+				if (maxKHz[(size_t)cpu] == 0)
+					continue;
+				knownCount++;
+				speeds.append(fmt::format("{}{}:{}", speeds.empty() ? "" : " ", cpu, maxKHz[(size_t)cpu] / 1000));
+				if (maxKHz[(size_t)cpu] * 10 >= top * 7)
+				{
+					tiers.fast |= (1ull << cpu);
+					fastCount++;
+					if (maxKHz[(size_t)cpu] * 100 >= top * 97)
+						tiers.fastest |= (1ull << cpu);
+				}
+				else
+					tiers.slow |= (1ull << cpu);
+			}
+			cemuLog_log(LogType::Force, "[CPU] host CPU top speeds in MHz (cpu:speed): {}", speeds.empty() ? "unknown" : speeds);
+			if (fastCount < 3 || fastCount >= knownCount)
+			{
+				cemuLog_log(LogType::Force, "[CPU] no clear split between fast and slow host CPUs, leaving thread placement to the system");
+				return;
+			}
+			s_tiers = tiers;
+#endif
+		});
