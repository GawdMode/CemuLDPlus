+private fun readSlots(): List<SlotInfo?> =
+    List(NativeEmulatedUSBDevices.MAX_DIMENSIONS_SLOTS) { index ->
+        val name = NativeEmulatedUSBDevices.getDimensionsFigureSlot(index) ?: return@List null
+        val number = try {
+            NativeEmulatedUSBDevices.getDimensionsFigureSlotNumber(index)
+        } catch (_: Throwable) {
+            -1
+        }
+        SlotInfo(CATALOG_BY_ID[number]?.name ?: name, number)
+    }
+
+private fun readLights(): List<PadLightState> {
+    val raw = try {
+        NativeEmulatedUSBDevices.getDimensionsPadLights()
+    } catch (_: Throwable) {
+        IntArray(12)
+    }
+    return List(3) { i ->
+        PadLightState(
+            rgb = raw.getOrElse(i * 4) { 0 },
+            mode = raw.getOrElse(i * 4 + 1) { 0 },
+            param1 = raw.getOrElse(i * 4 + 2) { 0 } and 0xFF,
+            param2 = (raw.getOrElse(i * 4 + 2) { 0 } shr 8) and 0xFF,
+        )
+    }
+}
+
+/** Figure files on the device: figure number -> file (first one by name), plus files that aren't in the catalog. */
+private data class InstalledFigures(val pathById: Map<Int, String>, val others: List<FigureEntry>)
+
+private fun readInstalledFigures(): InstalledFigures {
+    val files = try {
+        NativeEmulatedUSBDevices.getInstalledDimensionsMiniFigures().sortedBy { it.name.lowercase() }
+    } catch (_: Throwable) {
+        emptyList()
+    }
+    val pathById = HashMap<Int, String>()
+    val others = ArrayList<FigureEntry>()
+    for (file in files) {
+        val id = FigureNumbers.forPath(file.path)
+        if (id == 0 || CATALOG_BY_ID.containsKey(id)) { // 0 = a blank tag the game hasn't written to yet
+            pathById.putIfAbsent(id, file.path)
+        } else {
+            others.add(FigureEntry(id, file.name, 0, id >= 1000, "", 0, otherPath = file.path))
+        }
+    }
+    return InstalledFigures(pathById, others)
+}
+
+/** Letters and digits only, lower case, so "Ka-Pow" matches "kapow". */
+private fun searchKey(text: String) = text.lowercase().filter { it.isLetterOrDigit() }
+
+// light index for a pad number: 1 = center -> 0, 2 = left -> 1, 3 = right -> 2
+private fun lightIndexForPad(pad: Int) = (pad - 1).coerceIn(0, 2)
+
+@Composable
+fun ToyPadScreen() {
+    var slots by remember { mutableStateOf(readSlots()) }
+    var lights by remember { mutableStateOf(readLights()) }
+    var installed by remember { mutableStateOf(readInstalledFigures()) }
+    var selectedSlot by remember { mutableStateOf<Int?>(null) }
+    var selectedFigure by remember { mutableStateOf<FigureEntry?>(null) }
+    var moveSource by remember { mutableStateOf<Int?>(null) }
+    var errorMessage by remember { mutableStateOf<String?>(null) }
+    var franchise by remember { mutableIntStateOf(0) } // 0 = all
+    var query by remember { mutableStateOf("") }
+    var typing by remember { mutableStateOf(false) }
+    var infoFigure by remember { mutableStateOf<FigureEntry?>(null) } // figure whose info card is open (long press)
+    var abilityFilter by remember { mutableStateOf<String?>(null) }
+    var pickingAbility by remember { mutableStateOf(false) }
+
+    LaunchedEffect(Unit) {
+        var tick = 0
+        while (true) {
+            slots = readSlots()
+            lights = readLights()
+            if (tick % 16 == 0) {
+                installed = readInstalledFigures()
+            }
+            tick++
+            delay(250)
+        }
+    }
+
+    fun refresh() {
+        slots = readSlots()
+    }
+
+    fun clearSelection() {
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    /** Path of the figure file for this entry, making the figure the first time it's used. */
+    fun pathFor(entry: FigureEntry): String? {
+        entry.otherPath?.let { return it }
+        installed.pathById[entry.id]?.let { return it }
+        val created = try {
+            NativeEmulatedUSBDevices.createDimensionsFigure(entry.id.toLong())
+        } catch (_: Throwable) {
+            false
+        }
+        if (!created) return null
+        installed = readInstalledFigures()
+        return installed.pathById[entry.id]
+    }
+
+    fun loadFigure(entry: FigureEntry, index: Int) {
+        // a figure can only be in one place: if it's already on the pad, move it instead (also an unused blank tag)
+        val current = if (entry.id >= 0) slots.indexOfFirst { it?.number == entry.id } else -1
+        if (current >= 0) {
+            if (current != index) {
+                NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(current)
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[current], current)
+            }
+            errorMessage = null
+        } else {
+            val path = pathFor(entry)
+            val ok = path != null && NativeEmulatedUSBDevices.loadDimensionsFigure(path, SLOT_PADS[index], index)
+            errorMessage = if (ok) null else "Couldn't place ${entry.name}"
+        }
+        clearSelection()
+        refresh()
+    }
+
+    fun cancelMove() {
+        moveSource?.let { NativeEmulatedUSBDevices.cancelRemoveDimensionsFigure(it) }
+        moveSource = null
+        clearSelection()
+        refresh()
+    }
+
+    fun onSlotTapped(index: Int) {
+        errorMessage = null
+        typing = false
+        val source = moveSource
+        if (source != null) {
+            if (source == index) {
+                cancelMove()
+            } else {
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[source], source)
+                moveSource = null
+                clearSelection()
+                refresh()
+            }
+            return
+        }
+        val figure = selectedFigure
+        if (figure != null) {
+            loadFigure(figure, index)
+            return
+        }
+        selectedSlot = if (selectedSlot == index) null else index
+    }
+
+    fun onFigureTapped(entry: FigureEntry) {
+        errorMessage = null
+        typing = false
+        if (moveSource != null) return
+        val slot = selectedSlot
+        if (slot != null) {
+            loadFigure(entry, slot)
+            return
+        }
+        selectedFigure = if (selectedFigure == entry) null else entry
+    }
+
+    fun onRemove(index: Int) {
+        NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[index], index)
+        clearSelection()
+        refresh()
+    }
+
+    fun showInfoForSlot(index: Int) {
+        val number = slots[index]?.number ?: return
+        infoFigure = if (number == 0) BLANK_TAG else ENTRY_BY_ID[number] ?: return
+    }
+
+    fun placeFromInfo(entry: FigureEntry) {
+        infoFigure = null
+        val slot = selectedSlot
+        if (slot != null) loadFigure(entry, slot) else selectedFigure = entry
+    }
+
+    fun showAbility(ability: String) {
+        // everyone with this ability, across all franchises
+        infoFigure = null
+        abilityFilter = ability
+        franchise = 0
+        query = ""
+        typing = false
+        pickingAbility = false
+    }
+
+    fun onMove(index: Int) {
+        NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(index)
+        moveSource = index
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    val onPadNumbers = slots.mapNotNull { it?.number }.filter { it > 0 }.toSet()
+    val allEntries = remember(installed) { CATALOG_ENTRIES + installed.others }
+    val key = searchKey(query)
+    val ability = abilityFilter
+    val shown = remember(allEntries, franchise, key, ability) {
+        allEntries.filter { e ->
+            (franchise == 0 || e.franchise == franchise) &&
+                    (ability == null || ability in abilitiesOf(e.id)) &&
+                    (key.isEmpty() || searchKey(e.name).contains(key) ||
+                            searchKey(FRANCHISES.getOrNull(e.franchise - 1)?.name ?: "").contains(key) ||
+                            abilitiesOf(e.id).any { searchKey(it).contains(key) })
+        }
+    }
+    // abilities to pick from, with how many figures (in the chosen franchise) have each
+    val abilityCounts = remember(allEntries, franchise) {
+        val inFranchise = allEntries.filter { franchise == 0 || it.franchise == franchise }
+        ALL_ABILITIES.map { a -> a to inFranchise.count { a in abilitiesOf(it.id) } }.filter { it.second > 0 }
+    }
+    val characters = remember(shown) { shown.filter { !it.isVehicle }.sortedBy { it.name.lowercase() } }
+    val vehicles = remember(shown, franchise, key, ability) {
+        val list = shown.filter { it.isVehicle }
+        // inside a franchise keep each vehicle's three builds together; otherwise A to Z
+        val sorted = if (franchise != 0) list.sortedWith(compareBy({ it.family.lowercase() }, { it.build }, { it.name.lowercase() }))
+        else list.sortedBy { it.name.lowercase() }
+        // the blank tag comes first in every list, for when the game asks for a newly built vehicle
+        val showBlank = ability == null && (key.isEmpty() || searchKey(BLANK_TAG.name).contains(key))
+        if (showBlank) listOf(BLANK_TAG) + sorted else sorted
+    }
+
+    Box(modifier = Modifier.fillMaxSize()) {
+        ToyPadBackground()
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = 12.dp, vertical = 10.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            // title, with the search box in the space to its right
+            Row(
+                verticalAlignment = Alignment.CenterVertically,
+                horizontalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                if (!typing) {
+                    Text(
+                        text = "LEGO Dimensions Toy Pad",
+                        style = MaterialTheme.typography.titleMedium,
+                        fontWeight = FontWeight.SemiBold,
+                        color = TextOnBackground,
+                        maxLines = 1,
+                    )
+                }
+                SearchBox(
+                    query = query,
+                    typing = typing,
+                    onTap = {
+                        typing = true
+                        pickingAbility = false
+                    },
+                    onClear = { query = "" },
+                    modifier = Modifier.weight(1f),
+                )
+                AbilityButton(
+                    selected = abilityFilter,
+                    open = pickingAbility,
+                    onTap = {
+                        typing = false
+                        pickingAbility = !pickingAbility
+                    },
+                    onClear = { abilityFilter = null },
+                )
+            }
+
+            if (!typing) {
+                // the pad
+                Row(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .weight(1f),
+                    horizontalArrangement = Arrangement.spacedBy(8.dp),
+                ) {
+                    SidePad(
+                        slotIndices = LEFT_SLOTS,
+                        innerOnRight = true,
+                        light = lights[lightIndexForPad(2)],
+                        slots = slots,
+                        selectedSlot = selectedSlot,
+                        moveSource = moveSource,
+                        onSlotTapped = ::onSlotTapped,
+                        onSlotLongPressed = ::showInfoForSlot,
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight(),
+                    )
+                    CenterPad(
+                        light = lights[lightIndexForPad(1)],
+                        slot = slots[CENTER_SLOT],
+                        isSelected = selectedSlot == CENTER_SLOT,
+                        isMoveSource = moveSource == CENTER_SLOT,
+                        onTap = { onSlotTapped(CENTER_SLOT) },
+                        onLongPress = { showInfoForSlot(CENTER_SLOT) },
+                        modifier = Modifier
+                            .weight(0.95f)
+                            .fillMaxHeight(),
+                    )
+                    SidePad(
+                        slotIndices = RIGHT_SLOTS,
+                        innerOnRight = false,
+                        light = lights[lightIndexForPad(3)],
+                        slots = slots,
+                        selectedSlot = selectedSlot,
+                        moveSource = moveSource,
+                        onSlotTapped = ::onSlotTapped,
+                        onSlotLongPressed = ::showInfoForSlot,
+                        modifier = Modifier
+                            .weight(1f)
+                            .fillMaxHeight(),
+                    )
+                }
+
+                // what to do next (only shown while something is selected or being moved)
+                if (errorMessage != null || moveSource != null || selectedFigure != null || selectedSlot != null) ActionBar(
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    selectedFigure = selectedFigure,
+                    moveSource = moveSource,
+                    errorMessage = errorMessage,
+                    onMove = ::onMove,
+                    onRemove = ::onRemove,
+                    onCancel = {
+                        if (moveSource != null) cancelMove() else clearSelection()
+                    },
+                )
+            }
+
+            if (typing) {
+                OnScreenKeyboard(
+                    onKey = { query += it },
+                    onBackspace = { if (query.isNotEmpty()) query = query.dropLast(1) },
+                    onDone = { typing = false },
+                )
+            } else {
+                FranchiseStrip(selected = franchise, onSelect = { franchise = it })
+            }
+
+            // figure collection (or the list of abilities to pick from)
+            if (pickingAbility) AbilityPicker(
+                abilities = abilityCounts,
+                selected = abilityFilter,
+                onPick = { picked ->
+                    abilityFilter = if (abilityFilter == picked) null else picked
+                    pickingAbility = false
+                },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.15f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+            ) else LazyVerticalGrid(
+                columns = GridCells.Adaptive(minSize = 84.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.15f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+                contentPadding = PaddingValues(8.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                if (characters.isEmpty() && vehicles.isEmpty()) {
+                    val emptyText = when {
+                        key.isNotEmpty() -> "Nothing matches \"$query\""
+                        ability != null -> "No figures here with $ability"
+                        else -> "Nothing here"
+                    }
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel(emptyText) }
+                }
+                if (characters.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Characters (${characters.size})") }
+                    items(characters, key = { "c${it.id}${it.otherPath ?: ""}" }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.id in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                            onLongPress = { infoFigure = entry },
+                        )
+                    }
+                }
+                if (vehicles.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Vehicles and gadgets (${vehicles.count { it.id != BLANK_TAG.id }})") }
+                    items(vehicles, key = { "v${it.id}${it.otherPath ?: ""}" }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.id in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                            onLongPress = { infoFigure = entry },
+                        )
+                    }
+                }
+            }
+        }
+
+        // info card for a figure (long press on it in the list or on the pad)
+        infoFigure?.let { entry ->
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(Color(0xB3000000))
+                    .clickable(interactionSource = remember { MutableInteractionSource() }, indication = null) { infoFigure = null },
+                contentAlignment = Alignment.Center,
+            ) {
+                FigureInfoCard(
+                    entry = entry,
+                    isOnPad = entry.id in onPadNumbers,
+                    onAbility = ::showAbility,
+                    onShowFigure = { infoFigure = it },
+                    onPlace = { placeFromInfo(entry) },
+                    onClose = { infoFigure = null },
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun SearchBox(query: String, typing: Boolean, onTap: () -> Unit, onClear: () -> Unit, modifier: Modifier = Modifier) {
+    Row(
+        modifier = modifier
+            .height(40.dp)
+            .clip(RoundedCornerShape(20.dp))
+            .background(Color(0x99060B1E))
+            .border(if (typing) 2.dp else 1.dp, if (typing) Color.White else Color(0x55FFFFFF), RoundedCornerShape(20.dp))
+            .clickable(onClick = onTap)
+            .padding(horizontal = 14.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Text(
+            text = when {
+                query.isNotEmpty() -> query + if (typing) "|" else ""
+                typing -> "|"
+                else -> "Search figures"
+            },
+            color = if (query.isEmpty() && !typing) TextDim else TextOnBackground,
+            fontSize = 15.sp,
+            maxLines = 1,
+            overflow = TextOverflow.Ellipsis,
+            modifier = Modifier.weight(1f),
+        )
+        if (query.isNotEmpty()) {
+            Text(
+                text = "✕",
+                color = TextOnBackground,
+                fontSize = 16.sp,
+                modifier = Modifier
+                    .clip(CircleShape)
+                    .clickable(onClick = onClear)
+                    .padding(horizontal = 8.dp, vertical = 4.dp),
+            )
+        }
+    }
+}
