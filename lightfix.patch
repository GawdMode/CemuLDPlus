+
+	void DimensionsUSB::HandleLightCommand(std::span<const uint8, 32> buf)
+	{
+		const uint8 command = buf[2];
+		auto rgbAt = [&buf](size_t i) -> uint32 { return ((uint32)buf[i] << 16) | ((uint32)buf[i + 1] << 8) | (uint32)buf[i + 2]; };
+		{
+			// diagnostic: log the first few light commands so the byte layout can be verified
+			static sint32 s_lightLogBudget = 40;
+			if (s_lightLogBudget > 0)
+			{
+				s_lightLogBudget--;
+				std::string hex;
+				for (size_t i = 0; i < 26; i++)
+					hex += fmt::format("{:02x} ", buf[i]);
+				cemuLog_log(LogType::Force, "[ToyPadLight] {}", hex);
+			}
+		}
+		switch (command)
+		{
+		case 0xC0: // Color: pad, r, g, b
+		{
+			PadLight light;
+			light.rgb = rgbAt(5);
+			SetPadLight(buf[4], light);
+			break;
+		}
+		case 0xC2: // Fade: pad, speed, count, r, g, b
+		{
+			PadLight light;
+			light.mode = 1;
+			light.param1 = buf[5];
+			light.count = buf[6];
+			light.rgb = rgbAt(7);
+			SetPadLight(buf[4], light);
+			break;
+		}
+		case 0xC3: // Flash: pad, on time, off time, count, r, g, b
+		{
+			PadLight light;
+			light.mode = 2;
+			light.param1 = buf[5];
+			light.param2 = buf[6];
+			light.count = buf[7];
+			light.rgb = rgbAt(8);
+			SetPadLight(buf[4], light);
+			break;
+		}
+		case 0xC4: // Fade random: pad, speed, count
+		{
+			PadLight light;
+			light.mode = 3;
+			light.param1 = buf[5];
+			light.count = buf[6];
+			light.rgb = 0xFFFFFF;
+			SetPadLight(buf[4], light);
+			break;
+		}
+		case 0xC6: // Fade all: for each pad (center, left, right): enable, speed, count, r, g, b
+		{
+			for (uint8 p = 0; p < 3; p++)
+			{
+				size_t o = 4 + p * 6;
+				if (buf[o] == 0)
+					continue;
+				PadLight light;
+				light.mode = 1;
+				light.param1 = buf[o + 1];
+				light.count = buf[o + 2];
+				light.rgb = rgbAt(o + 3);
+				SetPadLight(p + 1, light);
+			}
+			break;
+		}
+		case 0xC7: // Flash all: for each pad: enable, on time, off time, count, r, g, b
+		{
+			for (uint8 p = 0; p < 3; p++)
+			{
+				size_t o = 4 + p * 7;
+				if (o + 6 >= buf.size() || buf[o] == 0)
+					continue;
+				PadLight light;
+				light.mode = 2;
+				light.param1 = buf[o + 1];
+				light.param2 = buf[o + 2];
+				light.count = buf[o + 3];
+				light.rgb = rgbAt(o + 4);
+				SetPadLight(p + 1, light);
+			}
+			break;
+		}
+		case 0xC8: // Color all: for each pad: enable, r, g, b
+		{
+			for (uint8 p = 0; p < 3; p++)
+			{
+				size_t o = 4 + p * 4;
+				if (buf[o] == 0)
+					continue;
+				PadLight light;
+				light.rgb = rgbAt(o + 1);
+				SetPadLight(p + 1, light);
+			}
+			break;
+		}
+		default:
+			break;
+		}
+	}
