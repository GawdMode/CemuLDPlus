+/** What a figure can do: its abilities, and for vehicles every build of it. */
+@Composable
+private fun FigureInfoCard(
+    entry: FigureEntry,
+    isOnPad: Boolean,
+    onAbility: (String) -> Unit,
+    onShowFigure: (FigureEntry) -> Unit,
+    onPlace: () -> Unit,
+    onClose: () -> Unit,
+) {
+    val shape = RoundedCornerShape(20.dp)
+    val abilities = abilitiesOf(entry.id)
+    val builds = remember(entry) {
+        if (entry.isVehicle && entry.family.isNotEmpty())
+            CATALOG_ENTRIES.filter { it.isVehicle && it.family == entry.family && it.franchise == entry.franchise }.sortedBy { it.build }
+        else emptyList()
+    }
+    val kind = when {
+        entry.id == BLANK_TAG.id -> "Blank vehicle tag"
+        !entry.isVehicle -> "Character"
+        builds.size > 1 -> "Vehicle · build ${entry.build} of ${builds.size}"
+        else -> "Vehicle or gadget"
+    }
+    Column(
+        modifier = Modifier
+            .padding(16.dp)
+            .fillMaxWidth()
+            .clip(shape)
+            .background(Color(0xF20B1430))
+            .border(1.dp, Color(0x55FFFFFF), shape)
+            // taps inside the card don't close it
+            .clickable(interactionSource = remember { MutableInteractionSource() }, indication = null) {}
+            .verticalScroll(rememberScrollState())
+            .padding(16.dp),
+        verticalArrangement = Arrangement.spacedBy(12.dp),
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(14.dp)) {
+            Portrait(number = entry.id, name = entry.name, ringColor = Bronze, ringWidth = 2.dp, modifier = Modifier.size(84.dp))
+            Column(modifier = Modifier.weight(1f), verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                Text(
+                    text = entry.name,
+                    color = TextOnBackground,
+                    fontSize = 20.sp,
+                    fontWeight = FontWeight.SemiBold,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                FranchiseLabel(entry.franchise)
+                Text(text = kind, color = TextDim, fontSize = 13.sp)
+            }
+            Text(
+                text = "✕",
+                color = TextOnBackground,
+                fontSize = 20.sp,
+                modifier = Modifier
+                    .align(Alignment.Top)
+                    .clip(CircleShape)
+                    .clickable(onClick = onClose)
+                    .padding(horizontal = 10.dp, vertical = 4.dp),
+            )
+        }
+
+        if (entry.id == BLANK_TAG.id) {
+            Text(
+                text = "When the game asks you to build a vehicle and place the model on the central panel, " +
+                        "put this on the center spot. The game writes that vehicle onto it, and from then on " +
+                        "it works as that vehicle.",
+                color = TextOnBackground,
+                fontSize = 14.sp,
+            )
+        } else {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Text(text = "Abilities", color = TextDim, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                if (abilities.isEmpty()) {
+                    Text(text = "No special abilities listed.", color = TextOnBackground, fontSize = 14.sp)
+                } else {
+                    FlowRow(
+                        horizontalArrangement = Arrangement.spacedBy(6.dp),
+                        verticalArrangement = Arrangement.spacedBy(6.dp),
+                    ) {
+                        abilities.forEach { ability -> AbilityChip(name = ability, onTap = { onAbility(ability) }) }
+                    }
+                    Text(text = "Tap an ability to see everyone who has it.", color = TextDim, fontSize = 12.sp)
+                }
+            }
+        }
+
+        if (builds.size > 1) {
+            Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                Text(text = "All builds", color = TextDim, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
+                builds.forEach { build ->
+                    val isThis = build.id == entry.id
+                    Row(
+                        modifier = Modifier
+                            .fillMaxWidth()
+                            .clip(RoundedCornerShape(12.dp))
+                            .background(if (isThis) Color(0x333D8BFF) else Color(0x14FFFFFF))
+                            .clickable(enabled = !isThis) { onShowFigure(build) }
+                            .padding(8.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(10.dp),
+                    ) {
+                        Portrait(number = build.id, name = build.name, ringColor = Bronze, ringWidth = 2.dp, modifier = Modifier.size(44.dp))
+                        Column(modifier = Modifier.weight(1f)) {
+                            Text(
+                                text = "${build.build}. ${build.name}",
+                                color = TextOnBackground,
+                                fontSize = 14.sp,
+                                fontWeight = if (isThis) FontWeight.SemiBold else FontWeight.Normal,
+                            )
+                            val buildAbilities = abilitiesOf(build.id)
+                            Text(
+                                text = if (buildAbilities.isEmpty()) "No special abilities listed" else buildAbilities.joinToString(" · "),
+                                color = TextDim,
+                                fontSize = 12.sp,
+                                lineHeight = 15.sp,
+                            )
+                        }
+                    }
+                }
+            }
+        }
+
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp, Alignment.End), modifier = Modifier.fillMaxWidth()) {
+            if (!isOnPad) Button(onClick = onPlace) { Text("Place on pad") }
+            OutlinedButton(onClick = onClose, colors = ButtonDefaults.outlinedButtonColors(contentColor = TextOnBackground)) { Text("Close") }
+        }
+    }
+}
