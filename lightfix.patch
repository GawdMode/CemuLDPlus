+@Composable
+fun ToyPadScreen() {
+    var slots by remember { mutableStateOf(readSlots()) }
+    var lights by remember { mutableStateOf(readLights()) }
+    var figures by remember { mutableStateOf(readFigures()) }
+    var selectedSlot by remember { mutableStateOf<Int?>(null) }
+    var selectedFigure by remember { mutableStateOf<FigureEntry?>(null) }
+    var moveSource by remember { mutableStateOf<Int?>(null) }
+    var errorMessage by remember { mutableStateOf<String?>(null) }
+
+    LaunchedEffect(Unit) {
+        var tick = 0
+        while (true) {
+            slots = readSlots()
+            lights = readLights()
+            if (tick % 16 == 0) {
+                figures = readFigures()
+            }
+            tick++
+            delay(250)
+        }
+    }
+
+    fun refresh() {
+        slots = readSlots()
+    }
+
+    fun clearSelection() {
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    fun loadFigure(entry: FigureEntry, index: Int) {
+        val ok = NativeEmulatedUSBDevices.loadDimensionsFigure(entry.figure.path, SLOT_PADS[index], index)
+        errorMessage = if (ok) null else "Couldn't place ${entry.figure.name}"
+        clearSelection()
+        refresh()
+    }
+
+    fun cancelMove() {
+        moveSource?.let { NativeEmulatedUSBDevices.cancelRemoveDimensionsFigure(it) }
+        moveSource = null
+        clearSelection()
+        refresh()
+    }
+
+    fun onSlotTapped(index: Int) {
+        errorMessage = null
+        val source = moveSource
+        if (source != null) {
+            if (source == index) {
+                cancelMove()
+            } else {
+                NativeEmulatedUSBDevices.moveDimensionsFigure(SLOT_PADS[index], index, SLOT_PADS[source], source)
+                moveSource = null
+                clearSelection()
+                refresh()
+            }
+            return
+        }
+        val figure = selectedFigure
+        if (figure != null) {
+            loadFigure(figure, index)
+            return
+        }
+        selectedSlot = if (selectedSlot == index) null else index
+    }
+
+    fun onFigureTapped(entry: FigureEntry) {
+        errorMessage = null
+        if (moveSource != null) return
+        val slot = selectedSlot
+        if (slot != null) {
+            loadFigure(entry, slot)
+            return
+        }
+        selectedFigure = if (selectedFigure == entry) null else entry
+    }
+
+    fun onRemove(index: Int) {
+        NativeEmulatedUSBDevices.clearDimensionsFigure(SLOT_PADS[index], index)
+        clearSelection()
+        refresh()
+    }
+
+    fun onMove(index: Int) {
+        NativeEmulatedUSBDevices.tempRemoveDimensionsFigure(index)
+        moveSource = index
+        selectedSlot = null
+        selectedFigure = null
+    }
+
+    val onPadNumbers = slots.mapNotNull { it?.number }.toSet()
+    val characters = figures.filter { it.number < 1000 }
+    val vehicles = figures.filter { it.number >= 1000 }
+
+    Box(modifier = Modifier.fillMaxSize()) {
+        ToyPadBackground()
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = 12.dp, vertical = 10.dp),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Text(
+                    text = "LEGO Dimensions Toy Pad",
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.SemiBold,
+                    color = TextOnBackground,
+                )
+                Spacer(Modifier.weight(1f))
+                MarkButton()
+            }
+
+            // the pad
+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1.35f),
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+            ) {
+                SidePad(
+                    slotIndices = LEFT_SLOTS,
+                    innerOnRight = true,
+                    light = lights[lightIndexForPad(2)],
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    moveSource = moveSource,
+                    onSlotTapped = ::onSlotTapped,
+                    modifier = Modifier
+                        .weight(1f)
+                        .fillMaxHeight(),
+                )
+                CenterPad(
+                    light = lights[lightIndexForPad(1)],
+                    slot = slots[CENTER_SLOT],
+                    isSelected = selectedSlot == CENTER_SLOT,
+                    isMoveSource = moveSource == CENTER_SLOT,
+                    onTap = { onSlotTapped(CENTER_SLOT) },
+                    modifier = Modifier
+                        .weight(0.95f)
+                        .fillMaxHeight(),
+                )
+                SidePad(
+                    slotIndices = RIGHT_SLOTS,
+                    innerOnRight = false,
+                    light = lights[lightIndexForPad(3)],
+                    slots = slots,
+                    selectedSlot = selectedSlot,
+                    moveSource = moveSource,
+                    onSlotTapped = ::onSlotTapped,
+                    modifier = Modifier
+                        .weight(1f)
+                        .fillMaxHeight(),
+                )
+            }
+
+            // what to do next
+            ActionBar(
+                slots = slots,
+                selectedSlot = selectedSlot,
+                selectedFigure = selectedFigure,
+                moveSource = moveSource,
+                errorMessage = errorMessage,
+                onMove = ::onMove,
+                onRemove = ::onRemove,
+                onCancel = {
+                    if (moveSource != null) cancelMove() else clearSelection()
+                },
+            )
+
+            // figure collection
+            if (figures.isEmpty()) {
+                Text(
+                    text = "No figures yet. Create figures in the emulated USB devices menu in the game's menu.",
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = TextOnBackground,
+                )
+            }
+            LazyVerticalGrid(
+                columns = GridCells.Adaptive(minSize = 84.dp),
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .weight(1f)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0x66040818)),
+                contentPadding = PaddingValues(8.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                if (characters.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Characters (${characters.size})") }
+                    items(characters, key = { it.figure.path }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.number > 0 && entry.number in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                        )
+                    }
+                }
+                if (vehicles.isNotEmpty()) {
+                    item(span = { GridItemSpan(maxLineSpan) }) { SectionLabel("Vehicles and gadgets (${vehicles.size})") }
+                    items(vehicles, key = { it.figure.path }) { entry ->
+                        FigureTile(
+                            entry = entry,
+                            isSelected = selectedFigure == entry,
+                            isOnPad = entry.number in onPadNumbers,
+                            onTap = { onFigureTapped(entry) },
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
