+	  public:
+		explicit SimpleRoomReverb(uint32 sampleRate)
+		{
+			static constexpr sint32 combTuning[8] = {1116, 1188, 1277, 1356, 1422, 1491, 1557, 1617};
+			static constexpr sint32 allpassTuning[4] = {556, 441, 341, 225};
+			static constexpr sint32 stereoSpread = 23;
+			const float scale = (float)sampleRate / 44100.0f;
+			for (sint32 side = 0; side < 2; side++)
+			{
+				for (sint32 i = 0; i < 8; i++)
+					m_comb[side][i].buffer.assign(std::max<sint32>(1, (sint32)((combTuning[i] + side * stereoSpread) * scale)), 0.0f);
+				for (sint32 i = 0; i < 4; i++)
+					m_allpass[side][i].buffer.assign(std::max<sint32>(1, (sint32)((allpassTuning[i] + side * stereoSpread) * scale)), 0.0f);
+			}
+		}
