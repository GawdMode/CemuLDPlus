+	std::atomic<uint64> s_statUnderruns{0};
+	std::atomic<uint64> s_statSilenceUs{0};
+	std::atomic<uint64> s_statDroppedBlocks{0};
+	std::atomic<uint32> s_statLowestBufferUs{UINT32_MAX};
+}
+
+void IAudioAPI::StatsCountBufferLevel(size_t bufferedBytes)
+{
+	if (!m_countStats || m_samplerate == 0 || m_channels == 0 || m_bitsPerSample < 8)
+		return;
+	const uint64 frames = bufferedBytes / (m_channels * (m_bitsPerSample / 8));
+	const uint32 us = (uint32)std::min<uint64>(frames * 1000000ull / m_samplerate, UINT32_MAX - 1);
+	uint32 current = s_statLowestBufferUs.load(std::memory_order_relaxed);
+	while (us < current && !s_statLowestBufferUs.compare_exchange_weak(current, us, std::memory_order_relaxed))
+		;
+}
+
+void IAudioAPI::StatsCountUnderrun(size_t missingBytes)
+{
+	if (!m_countStats || m_samplerate == 0 || m_channels == 0 || m_bitsPerSample < 8)
+		return;
+	const uint64 frames = missingBytes / (m_channels * (m_bitsPerSample / 8));
+	s_statUnderruns.fetch_add(1, std::memory_order_relaxed);
+	s_statSilenceUs.fetch_add(frames * 1000000ull / m_samplerate, std::memory_order_relaxed);
+}
+
+void IAudioAPI::StatsCountDroppedBlock()
+{
+	if (m_countStats)
+		s_statDroppedBlocks.fetch_add(1, std::memory_order_relaxed);
+}
+
+IAudioAPI::OutputStats IAudioAPI::TakeTVOutputStats()
+{
+	OutputStats stats{};
+	stats.underruns = s_statUnderruns.exchange(0, std::memory_order_relaxed);
+	stats.silenceUs = s_statSilenceUs.exchange(0, std::memory_order_relaxed);
+	stats.droppedBlocks = s_statDroppedBlocks.exchange(0, std::memory_order_relaxed);
+	stats.lowestBufferUs = s_statLowestBufferUs.exchange(UINT32_MAX, std::memory_order_relaxed);
+	return stats;
+}
