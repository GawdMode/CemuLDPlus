+import java.net.URL
+import java.util.concurrent.ConcurrentHashMap
+
+/** Settings for the Toy Pad on the second screen. */
+object ToyPadScreenSettings {
+    private const val PREFS = "toypad_screen"
+    private const val KEY_FIGURE_PICTURES = "figure_pictures"
+
+    fun figurePicturesEnabled(context: Context): Boolean =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean(KEY_FIGURE_PICTURES, true)
+
+    fun setFigurePicturesEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(KEY_FIGURE_PICTURES, enabled).apply()
+    }
+
+    /** Folder shown as "toypad" inside the app's folder (the one "Open Cemu folder" opens). */
+    fun folder(context: Context): File = File(context.getExternalFilesDir(null) ?: context.filesDir, "toypad")
+}
+
+private fun decodeScaled(file: File, maxSize: Int): Bitmap? {
+    return try {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.path, bounds)
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        var sample = 1
+        while (bounds.outWidth / (sample * 2) >= maxSize && bounds.outHeight / (sample * 2) >= maxSize) sample *= 2
+        BitmapFactory.decodeFile(file.path, BitmapFactory.Options().apply { inSampleSize = sample })
+    } catch (_: Throwable) {
+        null
+    }
+}
+
+/**
+ * Pictures of figures, by figure number. A picture is taken from the "toypad/figures" folder if one is there
+ * (named like 1.png for Batman, 1000.png for the Police Car). Otherwise it is downloaded once from the community
+ * LEGO-Dimensions-NFC collection and kept in that folder. Nothing is bundled with the app.
+ */
+object FigureImages {
+    private const val BASE_URL =
+        "https://raw.githubusercontent.com/skylandersNFC/LEGO-Dimensions-NFC/main/Dimensions_Images/images/Separate/Chteupnin%27s%20Assets/"
+    private const val RETRY_AFTER_MS = 60_000L
+
+    private val memory = LruCache<Int, ImageBitmap>(240)
+    private val missing = ConcurrentHashMap.newKeySet<Int>() // not in the collection
+    private val failedAt = ConcurrentHashMap<Int, Long>() // download failed (offline?), retry later
+    private val locks = ConcurrentHashMap<Int, Mutex>()
+    private val downloads = Semaphore(4)
+
+    fun folder(context: Context): File = File(ToyPadScreenSettings.folder(context), "figures")
+
+    fun cached(id: Int): ImageBitmap? = if (id > 0) memory.get(id) else null
+
+    suspend fun load(context: Context, id: Int): ImageBitmap? {
+        if (id <= 0) return null
+        memory.get(id)?.let { return it }
+        val lock = locks.getOrPut(id) { Mutex() }
+        return lock.withLock {
+            memory.get(id) ?: withContext(Dispatchers.IO) {
+                val dir = folder(context)
+                val local = listOf("png", "webp", "jpg", "jpeg")
+                    .map { File(dir, "$id.$it") }
+                    .firstOrNull { it.isFile && it.length() > 0 }
+                val file = local ?: if (ToyPadScreenSettings.figurePicturesEnabled(context)) download(dir, id) else null
+                file?.let { decodeScaled(it, 256) }?.asImageBitmap()?.also { memory.put(id, it) }
+            }
+        }
+    }
+
+    private suspend fun download(dir: File, id: Int): File? {
+        if (id in missing) return null
+        val lastFail = failedAt[id]
+        if (lastFail != null && System.currentTimeMillis() - lastFail < RETRY_AFTER_MS) return null
+        return downloads.withPermit {
+            try {
+                dir.mkdirs()
+                val connection = URL("$BASE_URL$id.png").openConnection() as HttpURLConnection
+                connection.connectTimeout = 8000
+                connection.readTimeout = 15000
+                try {
+                    when (connection.responseCode) {
+                        200 -> {
+                            val part = File(dir, "$id.png.part")
+                            connection.inputStream.use { input -> part.outputStream().use { input.copyTo(it) } }
+                            val out = File(dir, "$id.png")
+                            if (part.length() > 0 && part.renameTo(out)) {
+                                failedAt.remove(id)
+                                out
+                            } else {
+                                part.delete()
+                                failedAt[id] = System.currentTimeMillis()
+                                null
+                            }
+                        }
+
+                        404 -> {
+                            missing.add(id)
+                            null
+                        }
+
+                        else -> {
+                            failedAt[id] = System.currentTimeMillis()
+                            null
+                        }
+                    }
+                } finally {
+                    connection.disconnect()
+                }
+            } catch (_: Throwable) {
+                failedAt[id] = System.currentTimeMillis()
+                null
+            }
+        }
+    }
+}
+
+/** Figure numbers of installed figure files, read once per file. */
+object FigureNumbers {
+    private val byPath = ConcurrentHashMap<String, Int>()
+
+    fun forPath(path: String): Int = byPath.getOrPut(path) {
+        try {
+            NativeEmulatedUSBDevices.getDimensionsFigureNumber(path)
+        } catch (_: Throwable) {
+            -1
+        }
+    }
+}
+
+@Composable
+fun rememberFigureImage(id: Int): ImageBitmap? {
+    val context = LocalContext.current.applicationContext
+    val image = remember(id) { mutableStateOf(FigureImages.cached(id)) }
+    LaunchedEffect(id) {
+        if (image.value == null && id > 0) image.value = FigureImages.load(context, id)
+    }
+    return image.value
+}
+
+/** Optional picture behind the Toy Pad screen, chosen in the Emulated USB Devices settings. */
+object ToyPadBackgroundImage {
+    private const val MAX_SIZE = 1600
+
+    // bumped whenever the picture changes so screens reload it
+    var version by mutableIntStateOf(0)
+        private set
+
+    private fun file(context: Context) = File(ToyPadScreenSettings.folder(context), "background.jpg")
+
+    fun exists(context: Context) = file(context).isFile
+
+    fun load(context: Context): ImageBitmap? {
+        val f = file(context)
+        if (!f.isFile) return null
+        return decodeScaled(f, MAX_SIZE)?.asImageBitmap()
+    }
+
+    suspend fun save(context: Context, uri: Uri): Boolean = withContext(Dispatchers.IO) {
+        try {
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+            if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return@withContext false
+            var sample = 1
+            while (bounds.outWidth / (sample * 2) >= MAX_SIZE && bounds.outHeight / (sample * 2) >= MAX_SIZE) sample *= 2
+            val bitmap = context.contentResolver.openInputStream(uri)?.use {
+                BitmapFactory.decodeStream(it, null, BitmapFactory.Options().apply { inSampleSize = sample })
+            } ?: return@withContext false
+            val target = file(context)
+            target.parentFile?.mkdirs()
+            val part = File(target.path + ".part")
+            part.outputStream().use { bitmap.compress(Bitmap.CompressFormat.JPEG, 92, it) }
+            bitmap.recycle()
+            val ok = part.renameTo(target)
+            withContext(Dispatchers.Main) { version++ }
+            ok
+        } catch (_: Throwable) {
+            false
+        }
+    }
+
+    fun clear(context: Context) {
+        file(context).delete()
+        version++
+    }
+}
