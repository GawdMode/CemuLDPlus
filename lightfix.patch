+@Composable
+private fun SlotTile(
+    slot: SlotInfo?,
+    isSelected: Boolean,
+    isMoveSource: Boolean,
+    onTap: () -> Unit,
+    onLongPress: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val ringColor = when {
+        isMoveSource -> Amber
+        isSelected -> Color.White
+        slot != null -> Bronze
+        else -> Color(0x66FFFFFF)
+    }
+    Box(
+        modifier = modifier
+            .clip(CircleShape)
+            .combinedClickable(onClick = onTap, onLongClick = onLongPress),
+        contentAlignment = Alignment.Center,
+    ) {
+        Portrait(
+            number = slot?.number ?: -1,
+            name = slot?.name,
+            ringColor = ringColor,
+            ringWidth = if (isSelected || isMoveSource) 4.dp else 3.dp,
+            modifier = Modifier.fillMaxSize(),
+        )
+        if (isMoveSource) {
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .clip(CircleShape)
+                    .background(Color(0x55FFC107))
+            )
+        }
+    }
