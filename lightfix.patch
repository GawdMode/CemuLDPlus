+			"SetLoop", "GetOffsets", "SetAdpcm", "SetAdpcmLoop", "SetCurrentOffsetEx", "SetEndOffsetEx", "SetLoopOffsetEx", "GetCurrentOffsetEx", "SetOffsetsEx" };
+		AXVPB* vpb = __AXVPBArrayPtr + voiceIndex;
+		AXVPBInternal_t* internal = __AXVPBInternalVoiceArray + voiceIndex;
+		std::unique_lock _l(s_axHistMutex);
+		uint64 now = _AXDiagNowMs();
+		std::string out = fmt::format("[AXHist] v{} now: public samples {:08x} fmt {} loopFlag {} loop {:x} end {:x} cur {:x} | internal abs loop {:x} end {:x} cur {:x}",
+			voiceIndex, _swapEndianU32(vpb->offsets.samples), _swapEndianU16(vpb->offsets.format), _swapEndianU16(vpb->offsets.loopFlag),
