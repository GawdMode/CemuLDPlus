 package info.cemu.cemu.settings.emulatedusbdevices
 
+import android.widget.Toast
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
 import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import info.cemu.cemu.common.ui.components.Button
+import info.cemu.cemu.common.ui.components.Header
 import info.cemu.cemu.common.ui.components.ScreenContent
 import info.cemu.cemu.common.ui.components.Toggle
 import info.cemu.cemu.common.ui.localization.tr
+import info.cemu.cemu.emulation.toypadscreen.ToyPadBackgroundImage
+import info.cemu.cemu.emulation.toypadscreen.ToyPadScreenSettings
 import info.cemu.cemu.nativeinterface.NativeSettings
+import kotlinx.coroutines.launch
 
 @Composable
 fun EmulatedUSBDevicesSettingsScreen(navigateBack: () -> Unit) {
+    val context = LocalContext.current
+    val coroutineScope = rememberCoroutineScope()
+    var hasCustomBackground by remember { mutableStateOf(ToyPadBackgroundImage.exists(context)) }
+
+    val backgroundPicker = rememberLauncherForActivityResult(ActivityResultContracts.OpenDocument()) { uri ->
+        if (uri == null) return@rememberLauncherForActivityResult
+        coroutineScope.launch {
+            val ok = ToyPadBackgroundImage.save(context, uri)
+            hasCustomBackground = ToyPadBackgroundImage.exists(context)
+            Toast.makeText(
+                context,
+                if (ok) "Toy Pad background saved" else "Couldn't use that picture",
+                Toast.LENGTH_SHORT
+            ).show()
+        }
+    }
+
     ScreenContent(
         appBarText = tr("Emulated USB Devices settings"),
         navigateBack = navigateBack,
@@ -29,5 +60,33 @@ fun EmulatedUSBDevicesSettingsScreen(navigateBack: () -> Unit) {
             initialCheckedState = NativeSettings::isEmulateDimensionsToypadEnabled,
             onCheckedChanged = NativeSettings::setEmulateDimensionsToypadEnabled,
         )
+
+        Header("Toy Pad on the second screen")
+
+        Toggle(
+            label = "Figure pictures",
+            description = "Show pictures of your figures instead of their names, with characters standing on their " +
+                    "Toy Tag. Each picture is downloaded once (figures from the community LEGO-Dimensions-NFC " +
+                    "collection, Toy Tags from the LEGO Dimensions Wiki) and kept in the toypad folder.",
+            initialCheckedState = { ToyPadScreenSettings.figurePicturesEnabled(context) },
+            onCheckedChanged = { ToyPadScreenSettings.setFigurePicturesEnabled(context, it) },
+        )
+
+        Button(
+            label = "Choose background picture",
+            description = if (hasCustomBackground) "Using your picture" else "Using the built-in star map",
+            onClick = { backgroundPicker.launch(arrayOf("image/*")) },
+        )
+
+        if (hasCustomBackground) {
+            Button(
+                label = "Use the built-in star map",
+                description = "Remove your background picture",
+                onClick = {
+                    ToyPadBackgroundImage.clear(context)
+                    hasCustomBackground = false
+                },
+            )
+        }
     }
 }
