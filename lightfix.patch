+private fun readFigures(): List<FigureEntry> =
+    NativeEmulatedUSBDevices.getInstalledDimensionsMiniFigures()
+        .map { FigureEntry(it, FigureNumbers.forPath(it.path)) }
+        .sortedWith(compareBy({ it.number >= 1000 }, { it.figure.name.lowercase() }))
+
+// light index for a pad number: 1 = center -> 0, 2 = left -> 1, 3 = right -> 2
+private fun lightIndexForPad(pad: Int) = (pad - 1).coerceIn(0, 2)
