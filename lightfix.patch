+/** A small keyboard drawn on the Toy Pad screen itself, so typing never takes the controller away from the game. */
+@Composable
+private fun OnScreenKeyboard(onKey: (String) -> Unit, onBackspace: () -> Unit, onDone: () -> Unit) {
+    val rows = listOf("1234567890", "QWERTYUIOP", "ASDFGHJKL", "ZXCVBNM")
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(14.dp))
+            .background(Color(0xCC060B1E))
+            .padding(4.dp),
+        verticalArrangement = Arrangement.spacedBy(4.dp),
+    ) {
+        rows.forEachIndexed { rowIndex, row ->
+            Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(4.dp)) {
+                if (rowIndex == 2) Spacer(Modifier.weight(0.5f))
+                for (c in row) {
+                    KeyboardKey(label = c.toString(), modifier = Modifier.weight(1f)) { onKey(c.toString()) }
+                }
+                if (rowIndex == 2) Spacer(Modifier.weight(0.5f))
+                if (rowIndex == 3) {
+                    KeyboardKey(label = "⌫", modifier = Modifier.weight(1.5f), onTap = onBackspace)
+                    KeyboardKey(label = "Done", modifier = Modifier.weight(1.5f), highlighted = true, onTap = onDone)
+                }
+            }
+        }
+        Row(modifier = Modifier.fillMaxWidth()) {
+            KeyboardKey(label = "space", modifier = Modifier.fillMaxWidth()) { onKey(" ") }
+        }
+    }
+}
+
+@Composable
+private fun KeyboardKey(label: String, modifier: Modifier = Modifier, highlighted: Boolean = false, onTap: () -> Unit) {
+    Box(
+        modifier = modifier
+            .height(38.dp)
+            .clip(RoundedCornerShape(8.dp))
+            .background(if (highlighted) Color(0xFF3D6BDB) else Color(0x33FFFFFF))
+            .clickable(onClick = onTap),
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(text = label, color = Color.White, fontSize = 16.sp, fontWeight = FontWeight.Medium)
+    }
+}
+
+/** "All" plus one logo per franchise; tap one to show only its characters and vehicles. */
