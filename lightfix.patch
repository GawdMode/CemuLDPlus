+/** Downloads every figure picture, Toy Tag and franchise logo at once, so the Toy Pad screen works offline. */
+object PictureDownloader {
+    data class Progress(val done: Int, val total: Int, val failed: Int, val finished: Boolean)
+
+    private val _progress = MutableStateFlow<Progress?>(null)
+    val progress: StateFlow<Progress?> = _progress
+
+    // not tied to a screen, so leaving the settings screen doesn't stop the download
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var job: Job? = null
+
+    @Synchronized
+    fun start(context: Context) {
+        if (job?.isActive == true) return
+        val appContext = context.applicationContext
+        val work: List<Pair<RemoteImageCache, Int>> =
+            CATALOG.map { FigureImages to it.id } +
+                    TOY_TAG_URLS.keys.map { ToyTagImages to it } +
+                    FRANCHISES.map { FranchiseLogos to it.index }
+        _progress.value = Progress(0, work.size, 0, false)
+        job = scope.launch {
+            val done = AtomicInteger(0)
+            val failed = AtomicInteger(0)
+            work.map { (cache, id) ->
+                async {
+                    val ok = try {
+                        cache.ensureSaved(appContext, id)
+                    } catch (_: Throwable) {
+                        false
+                    }
+                    if (!ok) failed.incrementAndGet()
+                    _progress.value = Progress(done.incrementAndGet(), work.size, failed.get(), false)
+                }
+            }.awaitAll()
+            _progress.value = Progress(work.size, work.size, failed.get(), true)
+        }
+    }
+}
