+@Composable
+fun rememberToyTagImage(id: Int): ImageBitmap? = rememberRemoteImage(ToyTagImages, id)
+
+/** Optional picture behind the Toy Pad screen, chosen in the Emulated USB Devices settings. */
+object ToyPadBackgroundImage {
+    private const val MAX_SIZE = 1600
+
+    // bumped whenever the picture changes so screens reload it
+    var version by mutableIntStateOf(0)
+        private set
+
+    private fun file(context: Context) = File(ToyPadScreenSettings.folder(context), "background.jpg")
+
+    fun exists(context: Context) = file(context).isFile
+
+    fun load(context: Context): ImageBitmap? {
+        val f = file(context)
+        if (!f.isFile) return null
+        return decodeScaled(f, MAX_SIZE)?.asImageBitmap()
+    }
+
+    suspend fun save(context: Context, uri: Uri): Boolean = withContext(Dispatchers.IO) {
+        try {
+            val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+            context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+            if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return@withContext false
+            var sample = 1
+            while (bounds.outWidth / (sample * 2) >= MAX_SIZE && bounds.outHeight / (sample * 2) >= MAX_SIZE) sample *= 2
+            val bitmap = context.contentResolver.openInputStream(uri)?.use {
+                BitmapFactory.decodeStream(it, null, BitmapFactory.Options().apply { inSampleSize = sample })
+            } ?: return@withContext false
+            val target = file(context)
+            target.parentFile?.mkdirs()
+            val part = File(target.path + ".part")
+            part.outputStream().use { bitmap.compress(Bitmap.CompressFormat.JPEG, 92, it) }
+            bitmap.recycle()
+            val ok = part.renameTo(target)
+            withContext(Dispatchers.Main) { version++ }
+            ok
+        } catch (_: Throwable) {
+            false
+        }
+    }
+
+    fun clear(context: Context) {
+        file(context).delete()
+        version++
+    }
+}
