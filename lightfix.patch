+bool VulkanRenderer::surfaceCopy_copySurfaceRegionWithFormatConversion(LatteTexture* sourceTexture, sint32 srcMip, sint32 srcSlice, LatteTexture* destinationTexture, sint32 dstMip, sint32 dstSlice, sint32 srcX, sint32 srcY, sint32 dstX, sint32 dstY, sint32 width, sint32 height)
+{
+	LatteTextureVk* srcTextureVk = (LatteTextureVk*)sourceTexture;
+	LatteTextureVk* dstTextureVk = (LatteTextureVk*)destinationTexture;
+	if (srcTextureVk->isDepth == dstTextureVk->isDepth)
+		return false; // only depth<->color is handled here
+	if (!LatteTexture_doesEffectiveRescaleRatioMatch(srcTextureVk, srcMip, dstTextureVk, dstMip))
+		return false;
+	if (srcTextureVk->GetBPP() != dstTextureVk->GetBPP())
+		return false;
+	// scale to effective size
+	sint32 effectiveCopyWidth = width;
+	sint32 effectiveCopyHeight = height;
+	LatteTexture_scaleToEffectiveSize(sourceTexture, &effectiveCopyWidth, &effectiveCopyHeight, 0);
+	sint32 effectiveSrcX = srcX;
+	sint32 effectiveSrcY = srcY;
+	LatteTexture_scaleToEffectiveSize(sourceTexture, &effectiveSrcX, &effectiveSrcY, 0);
+	sint32 effectiveDstX = dstX;
+	sint32 effectiveDstY = dstY;
+	LatteTexture_scaleToEffectiveSize(destinationTexture, &effectiveDstX, &effectiveDstY, 0);
+	// make sure the region fits into both textures
+	sint32 srcEffectiveWidth, srcEffectiveHeight;
+	srcTextureVk->GetEffectiveSize(srcEffectiveWidth, srcEffectiveHeight, srcMip);
+	sint32 dstEffectiveWidth, dstEffectiveHeight;
+	dstTextureVk->GetEffectiveSize(dstEffectiveWidth, dstEffectiveHeight, dstMip);
+	if (effectiveSrcX + effectiveCopyWidth > srcEffectiveWidth || effectiveSrcY + effectiveCopyHeight > srcEffectiveHeight)
+		return false;
+	if (effectiveDstX + effectiveCopyWidth > dstEffectiveWidth || effectiveDstY + effectiveCopyHeight > dstEffectiveHeight)
+		return false;
+	surfaceCopy_viaDrawcall(srcTextureVk, srcMip, srcSlice, dstTextureVk, dstMip, dstSlice, effectiveCopyWidth, effectiveCopyHeight, effectiveSrcX, effectiveSrcY, effectiveDstX, effectiveDstY);
+	return true;
+}
